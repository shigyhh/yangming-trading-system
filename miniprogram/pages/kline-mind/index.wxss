  color: rgba(244, 235, 221, 0.68);
  border: 1rpx solid rgba(244, 235, 221, 0.12);
  font-family: "ZX-LXGW", "LXGW WenKai", "霞鹜文楷", "Songti SC", serif;
  font-size: 34rpx;
}

.gate-row.active .gate-seal {
  color: #14140f;
  border-color: rgba(216, 183, 111, 0.5);
  background: #d8b76f;
}

.gate-row text {
  display: block;
  color: #fff6e6;
  font-size: 28rpx;
  font-weight: 900;
}

.gate-row view view {
  margin-top: 8rpx;
  color: rgba(244, 235, 221, 0.6);
  font-size: 24rpx;
  line-height: 1.48;
}

.gate-row view .gate-check {
  color: rgba(216, 183, 111, 0.72);
  font-size: 22rpx;
}

.completion-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  flex-wrap: wrap;
}

.completion-card > view,
.completion-card > text {
  position: relative;
  z-index: 1;
}

.completion-card view view {
  margin-top: 8rpx;
  color: #f1d27d;
  font-size: 64rpx;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
}

.completion-card > text {
  flex: 1;
  color: rgba(244, 235, 221, 0.6);
  font-size: 24rpx;
  line-height: 1.55;
}

.bookmark-panel {
  flex: 1 0 100%;
  display: grid;
  gap: 16rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(216, 183, 111, 0.14);
  border-radius: 20rpx;
  background: rgba(216, 183, 111, 0.055);
}

.bookmark-panel text {
  display: block;
  color: #d8b76f;
  font-size: 24rpx;
  font-weight: 900;
}

.completion-card .bookmark-panel view view {
  margin-top: 8rpx;
  color: rgba(244, 235, 221, 0.66);
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.5;
}

.bookmark-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

@media (max-width: 340px) {
  .hero-meta,
  .market-rail,
  .sim-meta,
  .option-grid {
    grid-template-columns: 1fr;
  }

  .option-grid.boundary {
    grid-template-columns: 1fr;
  }

  .kline-hero .page-title {
    font-size: 56rpx;
  }

  .completion-card {
    align-items: flex-start;
    flex-direction: column;
  }
}
