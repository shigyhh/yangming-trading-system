.kline-page {
  background:
    radial-gradient(circle at 82% 4%, rgba(216, 183, 111, 0.16), transparent 34%),
    radial-gradient(circle at 12% 34%, rgba(95, 132, 117, 0.14), transparent 38%),
    linear-gradient(180deg, #07100e 0%, #0a1110 46%, #070a09 100%);
}

.ink-depth {
  position: fixed;
  inset: 0;
  pointer-events: none;
  opacity: 0.58;
  background:
    linear-gradient(115deg, transparent 0 18%, rgba(244, 235, 221, 0.035) 19%, transparent 23% 100%),
    radial-gradient(ellipse at 50% 18%, rgba(244, 235, 221, 0.07), transparent 44%);
}

.kline-hero,
.mind-wave,
.method-card,
.practice-card,
.prescription-card,
.gate-card,
.completion-card {
  position: relative;
  z-index: 1;
}

.hero-topline {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
}

.hero-topline text {
  color: rgba(216, 183, 111, 0.82);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.34em;
}

.hero-topline view {
  min-width: 112rpx;
  height: 48rpx;
  display: grid;
  place-items: center;
  border: 1rpx solid rgba(216, 183, 111, 0.22);
  border-radius: 999rpx;
  color: rgba(244, 235, 221, 0.66);
  background: rgba(255, 255, 255, 0.045);
  font-size: 22rpx;
  font-weight: 800;
}

.kline-hero .page-title {
  margin-top: 26rpx;
  font-size: 58rpx;
  letter-spacing: 0;
}

.kline-hero .page-subtitle {
  max-width: 640rpx;
  color: rgba(244, 235, 221, 0.7);
  font-size: 25rpx;
  line-height: 1.58;
}

.kline-one-thing {
  margin-top: 24rpx;
  padding: 20rpx 22rpx;
  border-left: 4rpx solid rgba(95, 132, 117, 0.64);
  border-radius: 0 22rpx 22rpx 0;
  background:
    linear-gradient(90deg, rgba(95, 132, 117, 0.13), rgba(244, 235, 221, 0.018));
}

.kline-one-thing text {
  display: block;
  color: rgba(216, 183, 111, 0.6);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.18em;
}

.kline-one-thing view {
  margin-top: 8rpx;
  color: rgba(244, 235, 221, 0.84);
  font-size: 25rpx;
  font-weight: 850;
  line-height: 1.5;
}

.hero-meta {
  margin-top: 34rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.hero-meta > view {
  min-height: 132rpx;
  padding: 20rpx 18rpx;
  border: 1rpx solid rgba(216, 183, 111, 0.16);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.045);
}

.hero-meta text,
.section-kicker,
.field-block > text,
.prescription-grid text,
.completion-card text:first-child {
  display: block;
  color: rgba(216, 183, 111, 0.76);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.18em;
}

.hero-meta view view {
  margin-top: 12rpx;
  color: #fff6e6;
  font-size: 25rpx;
  line-height: 1.42;
  font-weight: 800;
}

.market-rail {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}

.market-chip {
  min-height: 112rpx;
  padding: 18rpx;
  display: block;
  text-align: left;
  border: 1rpx solid rgba(244, 235, 221, 0.1);
  border-radius: 22rpx;
  color: rgba(244, 235, 221, 0.74);
  background: rgba(255, 255, 255, 0.038);
}

.market-chip text,
.market-chip view {
  position: relative;
  z-index: 2;
  display: block;
}

.market-chip text {
  color: #fff6e6;
  font-size: 28rpx;
  font-weight: 900;
}

.market-chip view {
  margin-top: 8rpx;
  color: rgba(244, 235, 221, 0.54);
  font-size: 21rpx;
  line-height: 1.36;
}

.market-chip.active {
  border-color: rgba(216, 183, 111, 0.38);
  background: rgba(216, 183, 111, 0.1);
}

.timeframe-rail {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  overflow: visible;
  padding-bottom: 4rpx;
}

.timeframe-chip {
  min-width: 0;
  height: 62rpx;
  padding: 0 10rpx;
  display: grid;
  place-items: center;
  border: 1rpx solid rgba(244, 235, 221, 0.1);
  border-radius: 999rpx;
  color: rgba(244, 235, 221, 0.7);
  background: rgba(255, 255, 255, 0.038);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: center;
}

.timeframe-chip.active {
  color: #14140f;
  border-color: rgba(216, 183, 111, 0.62);
  background: #d8b76f;
}

.mind-wave {
  margin-top: 24rpx;
  padding: 28rpx 24rpx 26rpx;
}

.wave-head {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  align-items: flex-start;
}

.wave-head text:first-child {
  display: block;
  color: #fff6e6;
  font-family: "ZX-LXGW", "LXGW WenKai", "霞鹜文楷", "Songti SC", serif;
  font-size: 42rpx;
  line-height: 1.25;
}

.wave-head view view {
  margin-top: 10rpx;
  color: rgba(244, 235, 221, 0.58);
  font-size: 24rpx;
  line-height: 1.55;
}

.wave-head > text {
  width: 76rpx;
  height: 76rpx;
  flex: 0 0 76rpx;
  display: grid;
  place-items: center;
  border-radius: 24rpx;
  color: #16160f;
  background:
    linear-gradient(180deg, rgba(255, 247, 207, 0.8), rgba(216, 183, 111, 0.92)),
    #d8b76f;
  font-family: "ZX-LXGW", "LXGW WenKai", "霞鹜文楷", "Songti SC", serif;
  font-size: 38rpx;
  font-weight: 900;
}

.wave-source-line {
  position: relative;
  z-index: 1;
  margin-top: 22rpx;
  padding: 16rpx 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(216, 183, 111, 0.1);
  background: rgba(255, 255, 255, 0.026);
}

.wave-source-line text {
  flex: 0 0 auto;
  color: rgba(216, 183, 111, 0.72);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.16em;
}

.wave-source-line view {
  min-width: 0;
  color: rgba(244, 235, 221, 0.58);
  font-size: 22rpx;
  line-height: 1.42;
  text-align: right;
}

.chart-toolbar {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
  padding: 18rpx;
  display: grid;
  width: 100%;
  max-width: 100%;
  overflow: hidden;
  gap: 10rpx;
  border: 1rpx solid rgba(244, 235, 221, 0.1);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.035);
}

.chart-toolbar-row {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(96rpx, 112rpx);
  align-items: center;
  gap: 10rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.chart-period-rail {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx;
  overflow-x: auto;
  white-space: nowrap;
  border: 1rpx solid rgba(244, 235, 221, 0.1);
  border-radius: 999rpx;
  background: rgba(5, 9, 8, 0.28);
}

.chart-period-rail > text {
  flex: 0 0 auto;
  padding: 0 8rpx 0 10rpx;
  color: rgba(244, 235, 221, 0.42);
  font-size: 19rpx;
  font-weight: 900;
  line-height: 1;
}

.chart-period-rail .timeframe-chip {
  flex: 0 0 auto;
  width: auto;
  min-width: 70rpx;
  height: 42rpx;
  margin: 0;
  padding: 0 16rpx;
  font-size: 20rpx;
}

.slice-change-btn {
  width: 100%;
  max-width: 112rpx;
  min-width: 0;
  height: 54rpx;
  margin: 0;
  padding: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  border: 1rpx solid rgba(217, 189, 122, 0.2);
  color: rgba(216, 183, 111, 0.88);
  background: rgba(216, 183, 111, 0.06);
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.2;
  box-sizing: border-box;
}

.chart-orientation-note {
  color: rgba(244, 235, 221, 0.5);
  font-size: 19rpx;
  font-weight: 800;
  line-height: 1.2;
}

.chart-zoom-rail {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}

.chart-zoom-chip {
  min-height: 56rpx;
  padding: 0 10rpx;
  display: grid;
  place-items: center;
  border-radius: 999rpx;
  color: rgba(244, 235, 221, 0.66);
  border: 1rpx solid rgba(244, 235, 221, 0.1);
  background: rgba(5, 9, 8, 0.26);
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: center;
}

.chart-zoom-chip.active {
  color: #14140f;
  border-color: rgba(216, 183, 111, 0.62);
  background: rgba(216, 183, 111, 0.9);
}

.chart-canvas-wrap {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
}

.wave-board-scroll {
  position: relative;
  z-index: 1;
  width: 100%;
  border-radius: 12rpx;
  overflow: hidden;
  border: 1rpx solid rgba(244, 235, 221, 0.08);
  background: #030504;
}

.chart-scroll-inner {
  width: 100%;
  min-width: 0;
  background: #030504;
}

.wave-board {
  position: relative;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  height: 336rpx;
  padding: 0;
  justify-content: flex-end;
  overflow: hidden;
  background:
    linear-gradient(90deg, rgba(50, 112, 96, 0.14) 1rpx, transparent 1rpx),
    linear-gradient(180deg, rgba(128, 36, 28, 0.24) 1rpx, transparent 1rpx),
    linear-gradient(180deg, rgba(4, 9, 8, 0.96), rgba(0, 0, 0, 0.98));
  background-size: 42rpx 100%, 100% 42rpx, 100% 100%;
}

.wave-board-content {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  box-sizing: border-box;
  padding: 24rpx 18rpx 18rpx;
  display: flex;
  align-items: flex-end;
  justify-content: flex-start;
  gap: 6rpx;
}

.chart-stepper {
  position: absolute;
  z-index: 8;
  right: 16rpx;
  top: 14rpx;
  display: inline-flex;
  overflow: hidden;
  border: 1rpx solid rgba(244, 235, 221, 0.16);
  border-radius: 6rpx;
  background: rgba(0, 0, 0, 0.72);
}

.chart-stepper-control {
  width: 54rpx;
  height: 42rpx;
  margin: 0;
  padding: 0;
  display: grid;
  place-items: center;
  border-radius: 0;
  color: rgba(244, 235, 221, 0.82);
  background: transparent;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1;
}

.chart-stepper-control + .chart-stepper-control {
  border-left: 1rpx solid rgba(244, 235, 221, 0.12);
}

.wave-board::before {
  content: "";
  position: absolute;
  left: 22rpx;
  right: 22rpx;
  top: 50%;
  height: 1rpx;
  background: rgba(160, 34, 30, 0.22);
}

.indicator-lines {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
}

.indicator-segment {
  position: absolute;
  height: 2rpx;
  transform-origin: 0 50%;
  opacity: 0.9;
}

.indicator-segment.ma5 {
  background: rgba(235, 217, 78, 0.88);
}

.indicator-segment.ma10 {
  background: rgba(190, 76, 215, 0.82);
}

.indicator-segment.ma20 {
  height: 2rpx;
  opacity: 0.78;
  background: rgba(234, 238, 116, 0.74);
}

.indicator-segment.boll {
  height: 1rpx;
  opacity: 0.72;
  background: rgba(58, 210, 105, 0.78);
}

.mind-candle {
  position: relative;
  z-index: 2;
  min-width: 0;
  flex: 0 0 8rpx;
  height: 286rpx;
  display: block;
  color: rgba(244, 235, 221, 0.58);
  box-shadow: none;
  border-radius: 2rpx;
}

.wave-board.zoom-overview .mind-candle {
  flex-basis: 5rpx;
}

.wave-board.zoom-standard .mind-candle {
  flex-basis: 12rpx;
}

.wave-board.zoom-focus .mind-candle {
  flex-basis: 20rpx;
}

.mind-candle::before,
.mind-candle::after {
  display: none;
}

.mind-candle .wick {
  position: absolute;
  left: 50%;
  width: 2rpx;
  transform: translateX(-50%);
  border-radius: 0;
  background: rgba(214, 224, 218, 0.72);
}

.mind-candle .body {
  position: absolute;
  left: 50%;
  width: 7rpx;
  min-height: 8rpx;
  transform: translateX(-50%);
  border-radius: 1rpx;
  background: rgba(214, 224, 218, 0.72);
  box-shadow: none;
}

.mind-candle .volume {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 7rpx;
  transform: translateX(-50%);
  border-radius: 1rpx 1rpx 0 0;
  background: rgba(214, 224, 218, 0.24);
}

.wave-board.zoom-overview .mind-candle .body,
.wave-board.zoom-overview .mind-candle .volume {
  width: 5rpx;
}

.wave-board.zoom-standard .mind-candle .body,
.wave-board.zoom-standard .mind-candle .volume {
  width: 10rpx;
}

.wave-board.zoom-focus .mind-candle .body,
.wave-board.zoom-focus .mind-candle .volume {
  width: 15rpx;
}

.mind-candle text {
  position: absolute;
  z-index: 3;
  left: 50%;
  top: 2rpx;
  width: 18rpx;
  height: 18rpx;
  display: grid;
  place-items: center;
  transform: translateX(-50%);
  border-radius: 2rpx;
  background: rgba(216, 183, 111, 0.18);
  color: rgba(216, 183, 111, 0.82);
  font-size: 13rpx;
  line-height: 1;
}

.mind-candle.gold .wick,
.mind-candle.gold .body,
.mind-candle.gold .volume {
  background: rgba(225, 62, 56, 0.92);
  box-shadow: none;
}

.mind-candle.jade .wick,
.mind-candle.jade .body,
.mind-candle.jade .volume {
  background: rgba(54, 214, 204, 0.9);
  box-shadow: none;
}

.mind-candle.ash .wick,
.mind-candle.ash .body,
.mind-candle.ash .volume {
  background: rgba(144, 132, 112, 0.58);
}

.mind-candle.flat .wick,
.mind-candle.flat .body,
.mind-candle.flat .volume {
  background: rgba(214, 224, 218, 0.54);
}

.mind-candle.focus text,
.mind-candle.selected text {
  color: #f6e0aa;
}

.mind-candle.selected .body {
  width: 14rpx;
  box-shadow:
    0 0 0 1rpx rgba(255, 223, 117, 0.72),
    0 0 0 3rpx rgba(255, 223, 117, 0.14);
}

.mind-candle.selected {
  background: linear-gradient(180deg, rgba(216, 183, 111, 0.08), transparent 70%);
}

.indicator-strip {
  position: relative;
  z-index: 4;
  min-height: 54rpx;
  padding: 8rpx 18rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  overflow-x: auto;
  white-space: nowrap;
  border-top: 1rpx solid rgba(244, 235, 221, 0.08);
  background: rgba(0, 0, 0, 0.96);
  box-sizing: border-box;
}

.chart-indicator-chip {
  flex: 0 0 auto;
  min-width: 64rpx;
  height: 38rpx;
  padding: 0 16rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 6rpx;
  border: 1rpx solid rgba(244, 235, 221, 0.14);
  color: rgba(244, 235, 221, 0.68);
  background: rgba(255, 255, 255, 0.03);
  font-size: 19rpx;
  font-weight: 900;
  line-height: 1;
  box-sizing: border-box;
}

.chart-indicator-chip.active {
  color: #14140f;
  border-color: rgba(216, 183, 111, 0.62);
  background: rgba(216, 183, 111, 0.88);
}

.indicator-divider {
  flex: 0 0 1rpx;
  width: 1rpx;
  height: 26rpx;
  margin: 0 4rpx;
  background: rgba(244, 235, 221, 0.14);
}

.sub-indicator-board {
  position: relative;
  width: 100%;
  height: 104rpx;
  padding: 0;
  box-sizing: border-box;
  overflow: hidden;
  border-top: 1rpx solid rgba(244, 235, 221, 0.07);
  background:
    linear-gradient(90deg, rgba(50, 112, 96, 0.12) 1rpx, transparent 1rpx),
    linear-gradient(180deg, rgba(128, 36, 28, 0.2) 1rpx, transparent 1rpx),
    #010303;
  background-size: 42rpx 100%, 100% 34rpx, 100% 100%;
}

.sub-indicator-content {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  box-sizing: border-box;
  padding: 8rpx 18rpx 12rpx;
  display: flex;
  align-items: flex-end;
  justify-content: flex-start;
  gap: 6rpx;
}

.sub-indicator-item {
  position: relative;
  z-index: 2;
  flex: 0 0 8rpx;
  height: 86rpx;
}

.sub-indicator-board.zoom-overview .sub-indicator-item {
  flex-basis: 5rpx;
}

.sub-indicator-board.zoom-standard .sub-indicator-item {
  flex-basis: 12rpx;
}

.sub-indicator-board.zoom-focus .sub-indicator-item {
  flex-basis: 20rpx;
}

.sub-bar {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 7rpx;
  transform: translateX(-50%);
  border-radius: 1rpx 1rpx 0 0;
  background: rgba(214, 224, 218, 0.34);
}

.sub-indicator-board.macd .sub-bar {
  bottom: auto;
}

.sub-indicator-board.zoom-overview .sub-bar {
  width: 5rpx;
}

.sub-indicator-board.zoom-standard .sub-bar {
  width: 10rpx;
}

.sub-indicator-board.zoom-focus .sub-bar {
  width: 15rpx;
}

.sub-indicator-item.gold .sub-bar {
  background: rgba(225, 62, 56, 0.78);
}

.sub-indicator-item.jade .sub-bar {
  background: rgba(54, 214, 204, 0.78);
}

.sub-line {
  position: absolute;
  z-index: 3;
  height: 2rpx;
  transform-origin: 0 50%;
  pointer-events: none;
}

.sub-line.dif {
  background: rgba(235, 217, 78, 0.86);
}

.sub-line.dea {
  background: rgba(190, 76, 215, 0.82);
}

.sub-line.boll-upper,
.sub-line.boll-lower {
  height: 1rpx;
  background: rgba(58, 210, 105, 0.74);
}

.sub-line.boll-mid {
  height: 1rpx;
  background: rgba(235, 217, 78, 0.62);
}

.sub-line.rsi {
  background: rgba(216, 183, 111, 0.82);
}

.sub-line.k {
  background: rgba(54, 214, 204, 0.78);
}

.sub-line.d {
  background: rgba(235, 217, 78, 0.82);
}

.sub-line.j {
  background: rgba(190, 76, 215, 0.78);
}

.history-empty {
  position: relative;
  z-index: 1;
  min-height: 300rpx;
  margin-top: 30rpx;
  padding: 44rpx 34rpx;
  display: grid;
  align-content: center;
  border: 1rpx dashed rgba(216, 183, 111, 0.2);
  border-radius: 24rpx;
  background:
    linear-gradient(180deg, rgba(244, 235, 221, 0.045), rgba(244, 235, 221, 0.018)),
    rgba(4, 8, 7, 0.46);
}

.history-empty view {
  color: #fff6e6;
  font-family: "ZX-LXGW", "LXGW WenKai", "霞鹜文楷", "Songti SC", serif;
  font-size: 40rpx;
}

.history-empty text {
  display: block;
  margin-top: 16rpx;
  color: rgba(244, 235, 221, 0.58);
  font-size: 25rpx;
  line-height: 1.62;
}

.simulation-console {
  position: relative;
  z-index: 1;
  margin-top: 22rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(216, 183, 111, 0.16);
  border-radius: 22rpx;
  background:
    linear-gradient(135deg, rgba(216, 183, 111, 0.07), rgba(95, 132, 117, 0.055)),
    rgba(5, 9, 8, 0.36);
}

.simulation-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.simulation-head > view {
  min-width: 0;
}

.simulation-head text {
  display: block;
  color: rgba(216, 183, 111, 0.8);
  font-size: 21rpx;
  font-weight: 900;
  letter-spacing: 0.16em;
}

.simulation-head view view {
  margin-top: 8rpx;
  color: rgba(244, 235, 221, 0.62);
  font-size: 22rpx;
  line-height: 1.4;
}

.emotion-badge {
  flex: 0 0 auto;
  min-width: 74rpx;
  height: 48rpx;
  display: grid;
  place-items: center;
  border-radius: 999rpx;
  color: #14140f !important;
  background: rgba(216, 183, 111, 0.88);
  font-size: 21rpx !important;
  letter-spacing: 0 !important;
}

.risk-hint,
.coach-hint,
.decision-prompt {
  margin-top: 16rpx;
  color: rgba(244, 235, 221, 0.62);
  font-size: 23rpx;
  line-height: 1.5;
}

.risk-hint {
  padding: 14rpx 16rpx;
  border-left: 4rpx solid rgba(95, 132, 117, 0.62);
  border-radius: 0 16rpx 16rpx 0;
  background: rgba(95, 132, 117, 0.08);
}

.risk-hint.required {
  border-left-color: rgba(216, 183, 111, 0.72);
  color: rgba(255, 246, 230, 0.8);
  background: rgba(216, 183, 111, 0.08);
}

.runtime-metrics {
  margin-top: 14rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
}

.runtime-metrics > view {
  min-width: 0;
  padding: 12rpx 10rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(244, 235, 221, 0.08);
  background: rgba(255, 255, 255, 0.026);
}

.runtime-metrics text {
  display: block;
  color: rgba(216, 183, 111, 0.56);
  font-size: 18rpx;
  font-weight: 900;
  line-height: 1.2;
}

.runtime-metrics view view {
  margin-top: 6rpx;
  color: rgba(244, 235, 221, 0.76);
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.22;
}

.coach-hint {
  color: rgba(216, 183, 111, 0.72);
}

.decision-prompt {
  color: rgba(244, 235, 221, 0.48);
  font-size: 21rpx;
}

.decision-actions {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
}

.decision-action {
  width: 100%;
  box-sizing: border-box;
}

.decision-btn {
  width: 100%;
  min-width: 0;
  min-height: 72rpx;
  margin: 0;
  padding: 0 6rpx;
  display: grid;
  align-content: center;
  justify-items: center;
  border-radius: 16rpx;
  border: 1rpx solid rgba(244, 235, 221, 0.1);
  color: rgba(244, 235, 221, 0.72);
  background: rgba(255, 255, 255, 0.035);
  line-height: 1.2;
  text-align: center;
  box-sizing: border-box;
}

.decision-btn text {
  color: inherit;
  font-size: 21rpx;
  font-weight: 900;
}

.decision-btn view {
  display: none;
}

.decision-btn.BUY,
.decision-btn.SELL {
  border-color: rgba(216, 183, 111, 0.16);
  background: rgba(216, 183, 111, 0.05);
}

.decision-btn.HOLD {
  border-color: rgba(95, 132, 117, 0.18);
  background: rgba(95, 132, 117, 0.07);
}

.runtime-next {
  width: 100%;
  min-height: 78rpx;
  margin-top: 16rpx;
  display: grid;
  place-items: center;
  border-radius: 999rpx;
  border: 1rpx solid rgba(216, 183, 111, 0.42);
  color: #14140f;
  background:
    linear-gradient(180deg, rgba(255, 247, 207, 0.82), rgba(216, 183, 111, 0.96)),
    #d8b76f;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.2;
}

.runtime-next.locked {
  color: rgba(244, 235, 221, 0.66);
  border-color: rgba(244, 235, 221, 0.12);
  background: rgba(255, 255, 255, 0.035);
}

.indicator-layer {
  position: relative;
  z-index: 1;
  margin-top: 22rpx;
  padding: 18rpx;
  display: grid;
  gap: 14rpx;
  border: 1rpx solid rgba(95, 132, 117, 0.18);
  border-radius: 22rpx;
  background:
    linear-gradient(90deg, rgba(95, 132, 117, 0.1), rgba(255, 255, 255, 0.026)),
    rgba(255, 255, 255, 0.028);
}

.indicator-title {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  align-items: flex-start;
}

.indicator-title text {
  color: rgba(216, 183, 111, 0.78);
  font-size: 21rpx;
  font-weight: 900;
  letter-spacing: 0.14em;
}

.indicator-title view {
  max-width: 360rpx;
  color: rgba(244, 235, 221, 0.46);
  font-size: 20rpx;
  line-height: 1.42;
  text-align: right;
}

.indicator-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
}

.indicator-chip {
  min-height: 84rpx;
  padding: 14rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(244, 235, 221, 0.1);
  background: rgba(5, 9, 8, 0.28);
}

.indicator-chip text {
  display: block;
  color: rgba(244, 235, 221, 0.86);
  font-size: 23rpx;
  font-weight: 900;
}

.indicator-chip view {
  margin-top: 6rpx;
  color: rgba(244, 235, 221, 0.48);
  font-size: 19rpx;
  line-height: 1.35;
}

.slice-playbook {
  position: relative;
  z-index: 1;
  margin-top: 22rpx;
  padding: 20rpx;
  display: grid;
  gap: 12rpx;
  border: 1rpx solid rgba(216, 183, 111, 0.12);
  border-radius: 20rpx;
  background:
    linear-gradient(90deg, rgba(95, 132, 117, 0.11), rgba(255, 255, 255, 0.024)),
    rgba(255, 255, 255, 0.032);
}

.slice-playbook-title {
  color: rgba(216, 183, 111, 0.76);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.16em;
}

.slice-playbook-step {
  display: grid;
  grid-template-columns: 42rpx 1fr;
  gap: 12rpx;
  align-items: start;
}

.slice-playbook-index {
  width: 42rpx;
  height: 42rpx;
  display: grid;
  place-items: center;
  border-radius: 14rpx;
  color: #14140f;
  background: rgba(216, 183, 111, 0.9);
  font-size: 22rpx;
  font-weight: 900;
}

.slice-playbook-copy {
  color: rgba(244, 235, 221, 0.76);
  font-size: 24rpx;
  line-height: 1.48;
}

.wave-question {
  position: relative;
  z-index: 1;
  margin-top: 26rpx;
  padding: 24rpx;
  border-left: 4rpx solid rgba(216, 183, 111, 0.52);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.04);
}

.wave-question text {
  color: #d8b76f;
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 0.18em;
}

.wave-question .guardrail {
  margin-top: 16rpx;
  color: rgba(244, 235, 221, 0.46);
  font-size: 22rpx;
  line-height: 1.5;
  letter-spacing: 0;
}

.wave-question view {
  margin-top: 10rpx;
  color: rgba(255, 246, 230, 0.88);
  font-family: "ZX-LXGW", "LXGW WenKai", "霞鹜文楷", "Songti SC", serif;
  font-size: 32rpx;
  line-height: 1.62;
}

.practice-card,
.method-card,
.prescription-card,
.gate-card,
.completion-card {
  margin-top: 28rpx;
  padding: 30rpx 28rpx;
}

.guide-toggle {
  margin-top: 22rpx;
}

.guide-toggle button {
  width: 100%;
  line-height: 1.2;
  text-align: center;
}

.practice-title,
.method-title,
.prescription-title,
.gate-title {
  position: relative;
  z-index: 1;
  margin-top: 10rpx;
  color: #fff6e6;
  font-family: "ZX-LXGW", "LXGW WenKai", "霞鹜文楷", "Songti SC", serif;
  font-size: 40rpx;
  line-height: 1.3;
}

.method-list {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
  display: grid;
  gap: 16rpx;
}

.method-row {
  min-height: 150rpx;
  display: grid;
  grid-template-columns: 58rpx 1fr;
  gap: 18rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(244, 235, 221, 0.1);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.038);
}

.method-row.firecracker {
  border-color: rgba(216, 183, 111, 0.28);
  background:
    radial-gradient(circle at 18% 0%, rgba(216, 183, 111, 0.12), transparent 45%),
    rgba(255, 255, 255, 0.04);
}

.method-index {
  width: 58rpx;
  height: 58rpx;
  display: grid;
  place-items: center;
  border-radius: 18rpx;
  color: #15150f;
  background: rgba(216, 183, 111, 0.92);
  font-size: 24rpx;
  font-weight: 900;
}

.method-copy text {
  display: block;
  color: #fff6e6;
  font-size: 29rpx;
  font-weight: 900;
}

.method-copy > view {
  margin-top: 8rpx;
  color: rgba(244, 235, 221, 0.62);
  font-size: 24rpx;
  line-height: 1.5;
}

.method-copy .method-focus {
  color: rgba(216, 183, 111, 0.78);
  font-size: 23rpx;
  font-weight: 800;
}

.method-steps {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.method-steps text {
  min-height: 46rpx;
  padding: 0 16rpx;
  display: grid;
  place-items: center;
  border: 1rpx solid rgba(244, 235, 221, 0.1);
  border-radius: 999rpx;
  color: rgba(244, 235, 221, 0.68);
  background: rgba(5, 9, 8, 0.28);
  font-size: 21rpx;
  font-weight: 800;
}

.field-block {
  position: relative;
  z-index: 1;
  margin-top: 30rpx;
}

.field-hint {
  margin-top: 10rpx;
  color: rgba(247, 239, 223, 0.58);
  font-size: 24rpx;
  line-height: 1.55;
}

.first-thought-focus,
.reaction-detail-tags,
.record-depth-fields {
  position: relative;
  z-index: 1;
}

.reaction-direction-row {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: 1fr;
  gap: 12rpx;
}

.reaction-direction-pill {
  width: 100%;
  min-width: 0;
  min-height: 122rpx;
  margin: 0;
  padding: 16rpx 12rpx;
  display: grid;
  align-content: center;
  justify-items: center;
  box-sizing: border-box;
  border-radius: 24rpx;
  color: rgba(244, 235, 221, 0.74);
  border: 1rpx solid rgba(244, 235, 221, 0.12);
  background: rgba(255, 255, 255, 0.035);
  line-height: 1.2;
  text-align: center;
}

.reaction-direction-pill text {
  color: inherit;
  font-size: 25rpx;
  font-weight: 900;
}

.reaction-direction-pill view {
  margin-top: 8rpx;
  color: rgba(244, 235, 221, 0.46);
  font-size: 19rpx;
  line-height: 1.35;
}

.reaction-direction-pill.active {
  color: #13140f;
  border-color: rgba(216, 183, 111, 0.75);
  background:
    linear-gradient(180deg, rgba(255, 247, 207, 0.72), rgba(216, 183, 111, 0.96)),
    #d8b76f;
}

.reaction-direction-pill.active view {
  color: rgba(19, 20, 15, 0.66);
}

.reaction-detail-tags {
  margin-top: 2rpx;
}

.record-depth-fields {
  margin-top: 10rpx;
  padding-top: 2rpx;
}

.compact-field {
  margin-top: 18rpx;
}

.field-mini-toggle {
  position: relative;
  z-index: 1;
  margin-top: 16rpx;
}

.field-mini-toggle button {
  width: 100%;
  min-height: 58rpx;
  font-size: 21rpx;
  line-height: 1.2;
  text-align: center;
}

.option-grid {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.option-grid.boundary {
  grid-template-columns: repeat(2, 1fr);
}

.option-pill {
  min-height: 76rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(244, 235, 221, 0.12);
  border-radius: 999rpx;
  color: rgba(244, 235, 221, 0.72);
  background: rgba(255, 255, 255, 0.04);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.2;
  text-align: center;
}

.option-pill text {
  position: relative;
  z-index: 2;
  color: inherit;
}

.option-pill.seal {
  min-height: 72rpx;
  font-family: "ZX-LXGW", "LXGW WenKai", "霞鹜文楷", "Songti SC", serif;
  font-size: 31rpx;
}

.option-pill.active {
  color: #13140f;
  border-color: rgba(216, 183, 111, 0.75);
  background:
    linear-gradient(180deg, rgba(255, 247, 207, 0.72), rgba(216, 183, 111, 0.96)),
    #d8b76f;
}

.insight-textarea {
  width: 100%;
  min-height: 176rpx;
  margin-top: 16rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(244, 235, 221, 0.12);
  border-radius: 20rpx;
  color: #fff6e6;
  background: rgba(5, 9, 8, 0.5);
  font-size: 28rpx;
  line-height: 1.58;
}

.save-btn {
  position: relative;
  z-index: 1;
  margin-top: 30rpx;
  line-height: 1.2;
}

.completion-card {
  overflow: hidden;
  border-color: rgba(95, 132, 117, 0.24);
  background:
    radial-gradient(circle at 88% 0%, rgba(95, 132, 117, 0.14), transparent 42%),
    rgba(255, 255, 255, 0.035);
}

.completion-mark {
  width: 68rpx;
  height: 68rpx;
  display: grid;
  place-items: center;
  border-radius: 50%;
  color: rgba(255, 236, 205, 0.92);
  border: 2rpx solid rgba(154, 73, 48, 0.66);
  background: rgba(120, 60, 45, 0.32);
  font-family: "ZX-LXGW", "LXGW WenKai", "霞鹜文楷", "Songti SC", serif;
  font-size: 32rpx;
  transform: rotate(-8deg);
}

.completion-card > view:nth-child(2) {
  margin-top: 18rpx;
}

.completion-card > view:nth-child(2) > text {
  display: block;
  color: rgba(244, 235, 221, 0.92);
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.35;
}

.completion-card > view:nth-child(2) > view {
  margin-top: 8rpx;
  color: rgba(244, 235, 221, 0.62);
  font-size: 24rpx;
  line-height: 1.5;
}

.completion-card > text {
  display: block;
  margin-top: 16rpx;
  color: rgba(244, 235, 221, 0.48);
  font-size: 21rpx;
  line-height: 1.5;
}

.completion-actions {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.completion-review-btn {
  grid-column: 1 / -1;
}

.path-links {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.prescription-grid {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
  display: grid;
  gap: 16rpx;
}

.prescription-grid > view {
  padding: 22rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.04);
}

.prescription-grid view view {
  margin-top: 10rpx;
  color: rgba(255, 246, 230, 0.8);
  font-size: 27rpx;
  line-height: 1.6;
}

.drill-card {
  position: relative;
  z-index: 1;
  margin-top: 22rpx;
  padding: 24rpx;
  border-left: 4rpx solid rgba(95, 132, 117, 0.72);
  border-radius: 18rpx;
  background: rgba(95, 132, 117, 0.08);
}

.drill-card text {
  display: block;
  color: #86b4a1;
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 0.16em;
}

.drill-card view {
  margin-top: 10rpx;
  color: rgba(255, 246, 230, 0.78);
  font-size: 26rpx;
  line-height: 1.56;
}

.gate-list {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
  display: grid;
  gap: 12rpx;
}

.gate-row {
  min-height: 106rpx;
  display: grid;
  grid-template-columns: 72rpx 1fr;
  gap: 18rpx;
  align-items: center;
  padding: 18rpx;
  border: 1rpx solid rgba(244, 235, 221, 0.1);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.032);
}

.gate-row.active {
  border-color: rgba(216, 183, 111, 0.34);
  background: rgba(216, 183, 111, 0.08);
}

.gate-seal {
  width: 72rpx;
  height: 72rpx;
  display: grid;
  place-items: center;
  border-radius: 22rpx;
  color: rgba(244, 235, 221, 0.68);
  border: 1rpx solid rgba(244, 235, 221, 0.12);
  font-family: "ZX-LXGW", "LXGW WenKai", "霞鹜文楷", "Songti SC", serif;
  font-size: 34rpx;
}

.gate-row.active .gate-seal {
  color: #14140f;
  border-color: rgba(216, 183, 111, 0.5);
  background: #d8b76f;
}

.gate-row text {
  display: block;
  color: #fff6e6;
  font-size: 28rpx;
  font-weight: 900;
}

.gate-row view view {
  margin-top: 8rpx;
  color: rgba(244, 235, 221, 0.6);
  font-size: 24rpx;
  line-height: 1.48;
}

.gate-row view .gate-check {
  color: rgba(216, 183, 111, 0.72);
  font-size: 22rpx;
}

.completion-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.completion-card > view,
.completion-card > text {
  position: relative;
  z-index: 1;
}

.completion-card view view {
  margin-top: 8rpx;
  color: #f1d27d;
  font-size: 64rpx;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
}

.completion-card > text {
  flex: 1;
  color: rgba(244, 235, 221, 0.6);
  font-size: 24rpx;
  line-height: 1.55;
}

@media (max-width: 340px) {
  .hero-meta,
  .market-rail,
  .reaction-direction-row,
  .option-grid {
    grid-template-columns: 1fr;
  }

  .wave-source-line {
    align-items: flex-start;
    flex-direction: column;
  }

  .wave-source-line view {
    text-align: left;
  }

  .option-grid.boundary {
    grid-template-columns: 1fr;
  }

  .kline-hero .page-title {
    font-size: 56rpx;
  }

  .completion-card {
    align-items: flex-start;
    flex-direction: column;
  }
}
