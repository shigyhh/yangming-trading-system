.kline-page {
  background:
    radial-gradient(circle at 82% 4%, rgba(216, 183, 111, 0.16), transparent 34%),
    radial-gradient(circle at 12% 34%, rgba(95, 132, 117, 0.14), transparent 38%),
    linear-gradient(180deg, #07100e 0%, #0a1110 46%, #070a09 100%);
}

.ink-depth {
  position: fixed;
  inset: 0;
  pointer-events: none;
  opacity: 0.58;
  background:
    linear-gradient(115deg, transparent 0 18%, rgba(244, 235, 221, 0.035) 19%, transparent 23% 100%),
    radial-gradient(ellipse at 50% 18%, rgba(244, 235, 221, 0.07), transparent 44%);
}

.kline-hero,
.mind-wave,
.method-card,
.practice-card,
.prescription-card,
.gate-card,
.completion-card {
  position: relative;
  z-index: 1;
}

.hero-topline {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
}

.hero-topline text {
  color: rgba(216, 183, 111, 0.82);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.34em;
}

.hero-topline view {
  min-width: 112rpx;
  height: 48rpx;
  display: grid;
  place-items: center;
  border: 1rpx solid rgba(216, 183, 111, 0.22);
  border-radius: 999rpx;
  color: rgba(244, 235, 221, 0.66);
  background: rgba(255, 255, 255, 0.045);
  font-size: 22rpx;
  font-weight: 800;
}

.kline-hero .page-title {
  margin-top: 26rpx;
  font-size: 58rpx;
  letter-spacing: 0;
}

.kline-hero .page-subtitle {
  max-width: 640rpx;
  color: rgba(244, 235, 221, 0.7);
  font-size: 25rpx;
  line-height: 1.58;
}

.kline-one-thing {
  margin-top: 24rpx;
  padding: 20rpx 22rpx;
  border-left: 4rpx solid rgba(95, 132, 117, 0.64);
  border-radius: 0 22rpx 22rpx 0;
  background:
    linear-gradient(90deg, rgba(95, 132, 117, 0.13), rgba(244, 235, 221, 0.018));
}

.kline-one-thing text {
  display: block;
  color: rgba(216, 183, 111, 0.6);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.18em;
}

.kline-one-thing view {
  margin-top: 8rpx;
  color: rgba(244, 235, 221, 0.84);
  font-size: 25rpx;
  font-weight: 850;
  line-height: 1.5;
}

.training-entry-panel {
  margin-top: 22rpx;
  display: grid;
  gap: 16rpx;
}

.training-entry-card,
.special-training-section,
.custom-training-section {
  padding: 20rpx;
  border: 1rpx solid rgba(244, 235, 221, 0.1);
  border-radius: 22rpx;
  background:
    radial-gradient(circle at 88% 0%, rgba(216, 183, 111, 0.08), transparent 38%),
    rgba(255, 255, 255, 0.036);
}

.training-entry-card.active,
.special-training-pack.active,
.custom-training-section.active {
  border-color: rgba(216, 183, 111, 0.34);
  background:
    radial-gradient(circle at 88% 0%, rgba(216, 183, 111, 0.14), transparent 40%),
    rgba(216, 183, 111, 0.065);
}

.training-entry-card.base {
  background:
    radial-gradient(circle at 90% 0%, rgba(95, 132, 117, 0.1), transparent 40%),
    rgba(255, 255, 255, 0.032);
}

.training-entry-head,
.special-training-title,
.special-pack-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.training-entry-head text,
.special-training-title text {
  color: rgba(216, 183, 111, 0.82);
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 0.16em;
}

.training-entry-head view,
.special-training-title view {
  color: rgba(244, 235, 221, 0.48);
  font-size: 21rpx;
  font-weight: 800;
}

.training-entry-main {
  margin-top: 12rpx;
  color: rgba(244, 235, 221, 0.88);
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.36;
}

.training-entry-meta,
.special-pack-meta {
  margin-top: 8rpx;
  color: rgba(216, 183, 111, 0.72);
  font-size: 21rpx;
  line-height: 1.45;
  font-weight: 820;
}

.special-training-list {
  margin-top: 16rpx;
  display: grid;
  gap: 14rpx;
}

.special-training-pack {
  padding: 18rpx;
  border: 1rpx solid rgba(244, 235, 221, 0.1);
  border-radius: 20rpx;
  background: rgba(8, 16, 14, 0.46);
}

.special-pack-head text {
  color: rgba(244, 235, 221, 0.88);
  font-size: 25rpx;
  font-weight: 900;
}

.special-pack-start {
  flex-shrink: 0;
  min-width: 132rpx;
  min-height: 56rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 1rpx solid rgba(216, 183, 111, 0.22);
  border-radius: 999rpx;
  color: #19150d;
  background: linear-gradient(180deg, #f3d98b, #c19a48);
  font-size: 22rpx;
  font-weight: 900;
  line-height: 56rpx;
}

.special-pack-start::after {
  border: 0;
}

.special-pack-goal {
  margin-top: 12rpx;
  color: rgba(244, 235, 221, 0.68);
  font-size: 23rpx;
  line-height: 1.55;
  font-weight: 760;
}

.custom-form-grid {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.custom-field {
  min-width: 0;
}

.custom-field text {
  display: block;
  color: rgba(216, 183, 111, 0.66);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.12em;
}

.custom-field input {
  box-sizing: border-box;
  width: 100%;
  min-height: 72rpx;
  margin-top: 10rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(244, 235, 221, 0.12);
  border-radius: 18rpx;
  color: rgba(244, 235, 221, 0.88);
  background: rgba(8, 16, 14, 0.48);
  font-size: 24rpx;
  font-weight: 800;
}

.custom-period-rail {
  margin-top: 16rpx;
  display: flex;
  gap: 10rpx;
  overflow-x: auto;
  padding-bottom: 2rpx;
}

.custom-period-rail button {
  min-width: 98rpx;
  height: 58rpx;
  flex: 0 0 auto;
  border: 1rpx solid rgba(244, 235, 221, 0.1);
  border-radius: 999rpx;
  color: rgba(244, 235, 221, 0.66);
  background: rgba(255, 255, 255, 0.036);
  font-size: 22rpx;
  font-weight: 900;
  line-height: 58rpx;
}

.custom-period-rail button::after,
.custom-start-btn::after,
.custom-action-buttons button::after {
  border: 0;
}

.custom-period-rail button.active {
  color: #15120d;
  border-color: rgba(216, 183, 111, 0.56);
  background: #d8b76f;
}

.custom-start-btn {
  width: 100%;
  min-height: 68rpx;
  margin: 18rpx 0 0;
  border-radius: 999rpx;
  color: #17130d;
  background: linear-gradient(180deg, #f3d98b, #c19a48);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 68rpx;
}

.custom-status {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(217, 189, 122, 0.13);
  background: rgba(255, 255, 255, 0.035);
}

.custom-status text {
  display: block;
  color: rgba(216, 183, 111, 0.84);
  font-size: 21rpx;
  font-weight: 900;
  letter-spacing: 0.1em;
}

.custom-status view {
  margin-top: 6rpx;
  color: rgba(244, 235, 221, 0.58);
  font-size: 21rpx;
  line-height: 1.45;
}

.sampling-status {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(217, 189, 122, 0.14);
  border-radius: 20rpx;
  background:
    radial-gradient(circle at 92% 0%, rgba(216, 183, 111, 0.1), transparent 42%),
    rgba(255, 255, 255, 0.035);
}

.sampling-status text {
  display: block;
  color: rgba(216, 183, 111, 0.86);
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 0.12em;
}

.sampling-status view {
  margin-top: 8rpx;
  color: rgba(244, 235, 221, 0.62);
  font-size: 22rpx;
  line-height: 1.45;
}

.sampling-status.loading {
  border-color: rgba(216, 183, 111, 0.24);
}

.sampling-status.matched {
  border-color: rgba(95, 132, 117, 0.34);
  background:
    radial-gradient(circle at 92% 0%, rgba(95, 132, 117, 0.14), transparent 42%),
    rgba(255, 255, 255, 0.035);
}

.sampling-status.fallback,
.sampling-status.error {
  border-color: rgba(120, 60, 45, 0.26);
  background:
    radial-gradient(circle at 92% 0%, rgba(120, 60, 45, 0.12), transparent 42%),
    rgba(255, 255, 255, 0.035);
}

.slice-switch {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
  border-radius: 22rpx;
  border: 1rpx solid rgba(217, 189, 122, 0.12);
  background: rgba(255, 255, 255, 0.035);
}

.slice-switch > view {
  min-width: 0;
}

.slice-switch text {
  display: block;
  color: rgba(244, 235, 221, 0.88);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.35;
}

.slice-switch view view {
  margin-top: 6rpx;
  color: rgba(244, 235, 221, 0.48);
  font-size: 20rpx;
  line-height: 1.42;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}

.slice-switch button {
  flex: 0 0 auto;
  min-height: 58rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  color: rgba(216, 183, 111, 0.84);
  border: 1rpx solid rgba(217, 189, 122, 0.16);
  background: rgba(216, 183, 111, 0.055);
  font-size: 21rpx;
  font-weight: 900;
}

.hero-meta {
  margin-top: 34rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.hero-meta > view {
  min-height: 132rpx;
  padding: 20rpx 18rpx;
  border: 1rpx solid rgba(216, 183, 111, 0.16);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.045);
}

.hero-meta text,
.section-kicker,
.field-block > text,
.prescription-grid text,
.completion-card text:first-child {
  display: block;
  color: rgba(216, 183, 111, 0.76);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.18em;
}

.hero-meta view view {
  margin-top: 12rpx;
  color: #fff6e6;
  font-size: 25rpx;
  line-height: 1.42;
  font-weight: 800;
}

.market-rail {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}

.market-chip {
  min-height: 112rpx;
  padding: 18rpx;
  display: block;
  text-align: left;
  border: 1rpx solid rgba(244, 235, 221, 0.1);
  border-radius: 22rpx;
  color: rgba(244, 235, 221, 0.74);
  background: rgba(255, 255, 255, 0.038);
}

.market-chip text,
.market-chip view {
  position: relative;
  z-index: 2;
  display: block;
}

.market-chip text {
  color: #fff6e6;
  font-size: 28rpx;
  font-weight: 900;
}

.market-chip view {
  margin-top: 8rpx;
  color: rgba(244, 235, 221, 0.54);
  font-size: 21rpx;
  line-height: 1.36;
}

.market-chip.active {
  border-color: rgba(216, 183, 111, 0.38);
  background: rgba(216, 183, 111, 0.1);
}

.timeframe-rail {
  margin-top: 16rpx;
  display: flex;
  gap: 10rpx;
  overflow-x: auto;
  padding-bottom: 4rpx;
}

.timeframe-chip {
  min-width: 112rpx;
  height: 62rpx;
  padding: 0 18rpx;
  flex: 0 0 auto;
  display: grid;
  place-items: center;
  border: 1rpx solid rgba(244, 235, 221, 0.1);
  border-radius: 999rpx;
  color: rgba(244, 235, 221, 0.7);
  background: rgba(255, 255, 255, 0.038);
  font-size: 24rpx;
  font-weight: 900;
}

.timeframe-chip.active {
  color: #14140f;
  border-color: rgba(216, 183, 111, 0.62);
  background: #d8b76f;
}

.mind-wave {
  margin-top: 24rpx;
  padding: 28rpx 24rpx 26rpx;
}

.wave-head {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  align-items: flex-start;
}

.wave-head text:first-child {
  display: block;
  color: #fff6e6;
  font-family: "ZX-LXGW", "LXGW WenKai", "霞鹜文楷", "Songti SC", serif;
  font-size: 42rpx;
  line-height: 1.25;
}

.wave-head view view {
  margin-top: 10rpx;
  color: rgba(244, 235, 221, 0.58);
  font-size: 24rpx;
  line-height: 1.55;
}

.wave-head > text {
  width: 76rpx;
  height: 76rpx;
  flex: 0 0 76rpx;
  display: grid;
  place-items: center;
  border-radius: 24rpx;
  color: #16160f;
  background:
    linear-gradient(180deg, rgba(255, 247, 207, 0.8), rgba(216, 183, 111, 0.92)),
    #d8b76f;
  font-family: "ZX-LXGW", "LXGW WenKai", "霞鹜文楷", "Songti SC", serif;
  font-size: 38rpx;
  font-weight: 900;
}

.sim-meta {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: 14rpx;
}

.sim-meta > view {
  min-height: 118rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.04);
}

.sim-meta text {
  display: block;
  color: rgba(216, 183, 111, 0.72);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.16em;
}

.sim-meta view view {
  margin-top: 10rpx;
  color: rgba(244, 235, 221, 0.72);
  font-size: 24rpx;
  line-height: 1.48;
}

.wave-board {
  position: relative;
  z-index: 1;
  height: 312rpx;
  margin-top: 30rpx;
  padding: 22rpx 12rpx 16rpx;
  display: grid;
  grid-template-columns: repeat(14, 1fr);
  align-items: end;
  gap: 4rpx;
  border-radius: 24rpx;
  background:
    linear-gradient(90deg, rgba(244, 235, 221, 0.035) 1rpx, transparent 1rpx),
    linear-gradient(180deg, rgba(244, 235, 221, 0.04) 1rpx, transparent 1rpx),
    linear-gradient(180deg, rgba(244, 235, 221, 0.045), rgba(244, 235, 221, 0.018)),
    rgba(4, 8, 7, 0.46);
  background-size: 46rpx 100%, 100% 56rpx, 100% 100%, 100% 100%;
}

.wave-board::before {
  content: "";
  position: absolute;
  left: 22rpx;
  right: 22rpx;
  top: 50%;
  height: 1rpx;
  background: rgba(216, 183, 111, 0.12);
}

.mind-candle {
  position: relative;
  min-width: 0;
  height: 268rpx;
  display: block;
  color: rgba(244, 235, 221, 0.58);
  box-shadow: none;
  border-radius: 14rpx;
}

.mind-candle::before,
.mind-candle::after {
  display: none;
}

.mind-candle .wick {
  position: absolute;
  left: 50%;
  width: 4rpx;
  transform: translateX(-50%);
  border-radius: 999rpx;
  background: rgba(244, 235, 221, 0.22);
}

.mind-candle .body {
  position: absolute;
  left: 50%;
  width: 18rpx;
  min-height: 18rpx;
  transform: translateX(-50%);
  border-radius: 4rpx;
  background: rgba(244, 235, 221, 0.2);
  box-shadow: 0 0 18rpx rgba(244, 235, 221, 0.08);
}

.mind-candle .volume {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 18rpx;
  transform: translateX(-50%);
  border-radius: 6rpx 6rpx 2rpx 2rpx;
  background: rgba(244, 235, 221, 0.12);
}

.mind-candle text {
  position: absolute;
  z-index: 3;
  left: 50%;
  top: 12rpx;
  width: 40rpx;
  height: 40rpx;
  display: grid;
  place-items: center;
  transform: translateX(-50%);
  border-radius: 50%;
  background: rgba(216, 183, 111, 0.22);
  color: rgba(244, 235, 221, 0.54);
  font-family: "ZX-LXGW", "LXGW WenKai", "霞鹜文楷", "Songti SC", serif;
  font-size: 23rpx;
}

.mind-candle.gold .wick,
.mind-candle.gold .body,
.mind-candle.gold .volume {
  background: rgba(216, 183, 111, 0.72);
  box-shadow: 0 0 28rpx rgba(216, 183, 111, 0.18);
}

.mind-candle.jade .wick,
.mind-candle.jade .body,
.mind-candle.jade .volume {
  background: rgba(95, 132, 117, 0.76);
  box-shadow: 0 0 24rpx rgba(95, 132, 117, 0.16);
}

.mind-candle.ash .wick,
.mind-candle.ash .body,
.mind-candle.ash .volume {
  background: rgba(144, 132, 112, 0.58);
}

.mind-candle.flat .wick,
.mind-candle.flat .body,
.mind-candle.flat .volume {
  background: rgba(244, 235, 221, 0.24);
}

.mind-candle.focus text,
.mind-candle.selected text {
  color: #f6e0aa;
}

.mind-candle.selected .body {
  width: 24rpx;
  box-shadow:
    0 0 0 1rpx rgba(255, 246, 230, 0.18),
    0 0 34rpx rgba(216, 183, 111, 0.28);
}

.mind-candle.selected {
  background: linear-gradient(180deg, rgba(216, 183, 111, 0.1), transparent 70%);
}

.chart-toolbar {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
  padding: 18rpx;
  display: grid;
  gap: 10rpx;
  border: 1rpx solid rgba(244, 235, 221, 0.1);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.035);
}

.chart-toolbar-row {
  min-width: 0;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 10rpx;
}

.chart-period-rail {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx;
  overflow-x: auto;
  white-space: nowrap;
  border: 1rpx solid rgba(244, 235, 221, 0.1);
  border-radius: 999rpx;
  background: rgba(5, 9, 8, 0.28);
}

.chart-period-rail > text {
  flex: 0 0 auto;
  padding: 0 8rpx 0 10rpx;
  color: rgba(244, 235, 221, 0.42);
  font-size: 19rpx;
  font-weight: 900;
  line-height: 1;
}

.chart-period-rail .timeframe-chip {
  flex: 0 0 auto;
  width: auto;
  min-width: 70rpx;
  height: 42rpx;
  margin: 0;
  padding: 0 16rpx;
  font-size: 20rpx;
}

.chart-orientation-note {
  color: rgba(244, 235, 221, 0.5);
  font-size: 19rpx;
  font-weight: 800;
  line-height: 1.35;
}

.chart-canvas-wrap {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
}

.wave-board-scroll {
  position: relative;
  z-index: 1;
  width: 100%;
  touch-action: pan-y;
  border-radius: 12rpx;
  overflow: hidden;
  border: 1rpx solid rgba(244, 235, 221, 0.08);
  background: #030504;
}

.chart-scroll-inner {
  width: 100%;
  min-width: 100%;
  background: #030504;
}

.chart-canvas-wrap .wave-board {
  width: 100%;
  min-width: 0;
  height: 336rpx;
  margin: 0;
  padding: 0;
  display: block;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: 0;
  background:
    linear-gradient(90deg, rgba(50, 112, 96, 0.14) 1rpx, transparent 1rpx),
    linear-gradient(180deg, rgba(128, 36, 28, 0.24) 1rpx, transparent 1rpx),
    linear-gradient(180deg, rgba(4, 9, 8, 0.96), rgba(0, 0, 0, 0.98));
  background-size: 42rpx 100%, 100% 42rpx, 100% 100%;
}

.wave-board-content {
  position: relative;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  padding: 24rpx 18rpx 18rpx;
  display: flex;
  align-items: flex-end;
  justify-content: flex-start;
  gap: var(--kline-gap, 6rpx);
}

.chart-stepper {
  position: absolute;
  z-index: 8;
  right: 16rpx;
  top: 14rpx;
  display: inline-flex;
  overflow: hidden;
  border: 1rpx solid rgba(244, 235, 221, 0.16);
  border-radius: 6rpx;
  background: rgba(0, 0, 0, 0.72);
}

.chart-stepper-control {
  width: 54rpx;
  height: 42rpx;
  display: grid;
  place-items: center;
  color: rgba(244, 235, 221, 0.82);
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1;
}

.chart-stepper-control + .chart-stepper-control {
  border-left: 1rpx solid rgba(244, 235, 221, 0.12);
}

.indicator-lines {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
}

.indicator-segment {
  position: absolute;
  height: 2rpx;
  transform-origin: 0 50%;
  opacity: 0.9;
}

.indicator-segment.ma5 {
  background: rgba(235, 217, 78, 0.88);
}

.indicator-segment.ma10 {
  background: rgba(190, 76, 215, 0.82);
}

.indicator-segment.ma20 {
  opacity: 0.78;
