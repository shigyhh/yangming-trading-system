.kline-page {
  background:
    radial-gradient(circle at 82% 4%, rgba(216, 183, 111, 0.16), transparent 34%),
    radial-gradient(circle at 12% 34%, rgba(95, 132, 117, 0.14), transparent 38%),
    linear-gradient(180deg, #07100e 0%, #0a1110 46%, #070a09 100%);
}

.ink-depth {
  position: fixed;
  inset: 0;
  pointer-events: none;
  opacity: 0.58;
  background:
    linear-gradient(115deg, transparent 0 18%, rgba(244, 235, 221, 0.035) 19%, transparent 23% 100%),
    radial-gradient(ellipse at 50% 18%, rgba(244, 235, 221, 0.07), transparent 44%);
}

.kline-hero,
.mind-wave,
.method-card,
.practice-card,
.prescription-card,
.gate-card,
.completion-card {
  position: relative;
  z-index: 1;
}

.hero-topline {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
}

.hero-topline text {
  color: rgba(216, 183, 111, 0.82);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.34em;
}

.hero-topline view {
  min-width: 112rpx;
  height: 48rpx;
  display: grid;
  place-items: center;
  border: 1rpx solid rgba(216, 183, 111, 0.22);
  border-radius: 999rpx;
  color: rgba(244, 235, 221, 0.66);
  background: rgba(255, 255, 255, 0.045);
  font-size: 22rpx;
  font-weight: 800;
}

.kline-hero .page-title {
  margin-top: 26rpx;
  font-size: 58rpx;
  letter-spacing: 0;
}

.kline-hero .page-subtitle {
  max-width: 640rpx;
  color: rgba(244, 235, 221, 0.7);
  font-size: 25rpx;
  line-height: 1.58;
}

.kline-one-thing {
  margin-top: 24rpx;
  padding: 20rpx 22rpx;
  border-left: 4rpx solid rgba(95, 132, 117, 0.64);
  border-radius: 0 22rpx 22rpx 0;
  background:
    linear-gradient(90deg, rgba(95, 132, 117, 0.13), rgba(244, 235, 221, 0.018));
}

.kline-one-thing text {
  display: block;
  color: rgba(216, 183, 111, 0.6);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.18em;
}

.kline-one-thing view {
  margin-top: 8rpx;
  color: rgba(244, 235, 221, 0.84);
  font-size: 25rpx;
  font-weight: 850;
  line-height: 1.5;
}

.hero-meta {
  margin-top: 34rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.hero-meta > view {
  min-height: 132rpx;
  padding: 20rpx 18rpx;
  border: 1rpx solid rgba(216, 183, 111, 0.16);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.045);
}

.hero-meta text,
.section-kicker,
.field-block > text,
.prescription-grid text,
.completion-card text:first-child {
  display: block;
  color: rgba(216, 183, 111, 0.76);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.18em;
}

.hero-meta view view {
  margin-top: 12rpx;
  color: #fff6e6;
  font-size: 25rpx;
  line-height: 1.42;
  font-weight: 800;
}

.market-rail {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}

.market-chip {
  min-height: 112rpx;
  padding: 18rpx;
  display: block;
  text-align: left;
  border: 1rpx solid rgba(244, 235, 221, 0.1);
  border-radius: 22rpx;
  color: rgba(244, 235, 221, 0.74);
  background: rgba(255, 255, 255, 0.038);
}

.market-chip text,
.market-chip view {
  position: relative;
  z-index: 2;
  display: block;
}

.market-chip text {
  color: #fff6e6;
  font-size: 28rpx;
  font-weight: 900;
}

.market-chip view {
  margin-top: 8rpx;
  color: rgba(244, 235, 221, 0.54);
  font-size: 21rpx;
  line-height: 1.36;
}

.market-chip.active {
  border-color: rgba(216, 183, 111, 0.38);
  background: rgba(216, 183, 111, 0.1);
}

.timeframe-rail {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  overflow: visible;
  padding-bottom: 4rpx;
}

.timeframe-chip {
  min-width: 0;
  height: 62rpx;
  padding: 0 10rpx;
  display: grid;
  place-items: center;
  border: 1rpx solid rgba(244, 235, 221, 0.1);
  border-radius: 999rpx;
  color: rgba(244, 235, 221, 0.7);
  background: rgba(255, 255, 255, 0.038);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: center;
}

.timeframe-chip.active {
  color: #14140f;
  border-color: rgba(216, 183, 111, 0.62);
  background: #d8b76f;
}

.mind-wave {
  margin-top: 24rpx;
  padding: 28rpx 24rpx 26rpx;
}

.wave-head {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  align-items: flex-start;
}

.wave-head text:first-child {
  display: block;
  color: #fff6e6;
  font-family: "ZX-LXGW", "LXGW WenKai", "霞鹜文楷", "Songti SC", serif;
  font-size: 42rpx;
  line-height: 1.25;
}

.wave-head view view {
  margin-top: 10rpx;
  color: rgba(244, 235, 221, 0.58);
  font-size: 24rpx;
  line-height: 1.55;
}

.wave-source-line {
  position: relative;
  z-index: 1;
  margin-top: 22rpx;
  padding: 16rpx 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(216, 183, 111, 0.1);
  background: rgba(255, 255, 255, 0.026);
}

.wave-source-line text {
  flex: 0 0 auto;
  color: rgba(216, 183, 111, 0.72);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.16em;
}

.wave-source-detail {
  min-width: 0;
  color: rgba(244, 235, 221, 0.58);
  font-size: 22rpx;
  line-height: 1.42;
  text-align: right;
}

.chart-toolbar {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
  padding: 18rpx;
  display: grid;
  width: 100%;
  max-width: 100%;
  overflow: hidden;
  gap: 10rpx;
  border: 1rpx solid rgba(244, 235, 221, 0.1);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.035);
}

.chart-toolbar-row {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(96rpx, 112rpx);
  align-items: center;
  gap: 10rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.chart-period-rail {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx;
  overflow-x: auto;
  white-space: nowrap;
  border: 1rpx solid rgba(244, 235, 221, 0.1);
  border-radius: 999rpx;
  background: rgba(5, 9, 8, 0.28);
}

.chart-period-rail > text {
  flex: 0 0 auto;
  padding: 0 8rpx 0 10rpx;
  color: rgba(244, 235, 221, 0.42);
  font-size: 19rpx;
  font-weight: 900;
  line-height: 1;
}

.chart-period-rail .timeframe-chip {
  flex: 0 0 auto;
  width: auto;
  min-width: 70rpx;
  height: 42rpx;
  margin: 0;
  padding: 0 16rpx;
  font-size: 20rpx;
}

.slice-change-btn {
  width: 100%;
  max-width: 112rpx;
  min-width: 0;
  height: 54rpx;
  margin: 0;
  padding: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  border: 1rpx solid rgba(217, 189, 122, 0.2);
  color: rgba(216, 183, 111, 0.88);
  background: rgba(216, 183, 111, 0.06);
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.2;
  box-sizing: border-box;
}

.slice-change-btn.disabled,
.slice-change-btn[disabled] {
  opacity: 0.48;
  color: rgba(244, 235, 221, 0.46);
  border-color: rgba(244, 235, 221, 0.1);
  background: rgba(255, 255, 255, 0.03);
}

.chart-orientation-note {
  color: rgba(244, 235, 221, 0.5);
  font-size: 19rpx;
  font-weight: 800;
  line-height: 1.2;
}

.chart-zoom-rail {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}

.chart-zoom-chip {
  min-height: 56rpx;
  padding: 0 10rpx;
  display: grid;
  place-items: center;
  border-radius: 999rpx;
  color: rgba(244, 235, 221, 0.66);
  border: 1rpx solid rgba(244, 235, 221, 0.1);
  background: rgba(5, 9, 8, 0.26);
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: center;
}

.chart-zoom-chip.active {
  color: #14140f;
  border-color: rgba(216, 183, 111, 0.62);
  background: rgba(216, 183, 111, 0.9);
}

.chart-canvas-wrap {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
}

.chart-canvas-scroll {
  position: relative;
  z-index: 1;
  width: 100%;
  touch-action: pan-y;
  border-radius: 12rpx;
  overflow: hidden;
  border: 1rpx solid rgba(244, 235, 221, 0.08);
  background: #030504;
}

.chart-scroll-inner {
  width: 100%;
  min-width: 100%;
  background: #030504;
}

.chart-canvas-stage {
  position: relative;
  width: 100%;
  min-width: 100%;
  background: #030504;
}

.kline-indicator-canvas {
  display: block;
  width: 100%;
  box-sizing: border-box;
  height: 104rpx;
  border-top: 1rpx solid rgba(244, 235, 221, 0.07);
  background: #030504;
}

.kline-main-canvas {
  display: block;
  width: 100%;
  box-sizing: border-box;
  height: 336rpx;
  background: #030504;
}

.chart-crosshair-tooltip {
  position: absolute;
  z-index: 9;
  width: 232rpx;
  padding: 12rpx 14rpx;
  border: 1rpx solid rgba(216, 183, 111, 0.34);
  border-radius: 10rpx;
  color: rgba(244, 235, 221, 0.9);
  background: rgba(4, 7, 6, 0.86);
  box-shadow: 0 12rpx 34rpx rgba(0, 0, 0, 0.46);
  pointer-events: none;
  box-sizing: border-box;
}

.crosshair-tooltip-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  color: rgba(216, 183, 111, 0.88);
  font-size: 18rpx;
  font-weight: 900;
  line-height: 1.2;
}

.crosshair-tooltip-grid {
  margin-top: 8rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 6rpx 10rpx;
}

.crosshair-metric {
  min-width: 0;
  color: rgba(244, 235, 221, 0.72);
  font-size: 18rpx;
  font-weight: 800;
  line-height: 1.2;
  overflow-wrap: anywhere;
}

.crosshair-metric-wide {
  grid-column: 1 / -1;
}

.chart-crosshair-readout {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 118rpx;
  z-index: 7;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 1rpx;
  overflow: hidden;
  border: 1rpx solid rgba(216, 183, 111, 0.2);
  border-radius: 10rpx;
  background: rgba(4, 7, 6, 0.82);
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.38);
  pointer-events: none;
}

.crosshair-readout-item {
  min-width: 0;
  padding: 10rpx 8rpx;
  background: rgba(244, 235, 221, 0.035);
}

.crosshair-readout-label {
  display: block;
  margin-bottom: 4rpx;
  color: rgba(216, 183, 111, 0.68);
  font-size: 17rpx;
  font-weight: 800;
  line-height: 1.2;
}

.crosshair-readout-value {
  color: rgba(244, 235, 221, 0.84);
  font-size: 19rpx;
  font-weight: 900;
  line-height: 1.15;
  overflow-wrap: anywhere;
}

.chart-crosshair-readout.up .crosshair-readout-item:nth-child(1) .crosshair-readout-value,
.chart-crosshair-readout.up .crosshair-readout-item:nth-child(2) .crosshair-readout-value {
  color: rgba(225, 62, 56, 0.92);
}

.chart-crosshair-readout.down .crosshair-readout-item:nth-child(1) .crosshair-readout-value,
.chart-crosshair-readout.down .crosshair-readout-item:nth-child(2) .crosshair-readout-value {
  color: rgba(54, 214, 204, 0.9);
}

.chart-stepper {
  position: absolute;
  z-index: 20;
  right: 12rpx;
  top: 14rpx;
  display: flex;
  overflow: hidden;
  border: 1rpx solid rgba(244, 235, 221, 0.16);
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.72);
}

.chart-stepper-control {
  width: 48rpx;
  height: 42rpx;
  margin: 0;
  padding: 0;
  display: block;
  border-radius: 0;
  color: rgba(244, 235, 221, 0.82);
  background: transparent;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 42rpx;
  text-align: center;
}

.chart-stepper-control + .chart-stepper-control {
  border-left: 1rpx solid rgba(244, 235, 221, 0.12);
}

.chart-gesture-hint {
  margin-top: 10rpx;
  color: rgba(244, 235, 221, 0.42);
  font-size: 18rpx;
  font-weight: 800;
  line-height: 1.35;
  text-align: center;
}

.indicator-strip {
  position: absolute;
  z-index: 7;
  top: 337rpx;
  left: 1rpx;
  right: 1rpx;
  height: 54rpx;
  padding: 8rpx 18rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  overflow-x: auto;
  white-space: nowrap;
  border-top: 1rpx solid rgba(244, 235, 221, 0.08);
  background: rgba(0, 0, 0, 0.96);
  box-sizing: border-box;
}

.indicator-strip-spacer {
  height: 54rpx;
  border-top: 1rpx solid rgba(244, 235, 221, 0.08);
  background: rgba(0, 0, 0, 0.96);
  box-sizing: border-box;
}

.chart-indicator-chip {
  flex: 0 0 auto;
  min-width: 64rpx;
  height: 38rpx;
  padding: 0 16rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 6rpx;
  border: 1rpx solid rgba(244, 235, 221, 0.14);
  color: rgba(244, 235, 221, 0.68);
  background: rgba(255, 255, 255, 0.03);
  font-size: 19rpx;
  font-weight: 900;
  line-height: 1;
  box-sizing: border-box;
}

.chart-indicator-chip.active {
  color: #14140f;
  border-color: rgba(216, 183, 111, 0.62);
  background: rgba(216, 183, 111, 0.88);
}

.indicator-divider {
  flex: 0 0 1rpx;
  width: 1rpx;
  height: 26rpx;
  margin: 0 4rpx;
  background: rgba(244, 235, 221, 0.14);
}

.history-empty {
  position: relative;
  z-index: 1;
  min-height: 300rpx;
  margin-top: 30rpx;
  padding: 44rpx 34rpx;
  display: grid;
  align-content: center;
  border: 1rpx dashed rgba(216, 183, 111, 0.2);
  border-radius: 24rpx;
  background:
    linear-gradient(180deg, rgba(244, 235, 221, 0.045), rgba(244, 235, 221, 0.018)),
    rgba(4, 8, 7, 0.46);
}

.history-empty view {
  color: #fff6e6;
  font-family: "ZX-LXGW", "LXGW WenKai", "霞鹜文楷", "Songti SC", serif;
  font-size: 40rpx;
}

.history-empty text {
  display: block;
  margin-top: 16rpx;
  color: rgba(244, 235, 221, 0.58);
  font-size: 25rpx;
  line-height: 1.62;
}

.history-setup-btn {
  width: 360rpx;
  min-height: 76rpx;
  margin: 28rpx 0 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  border: 1rpx solid rgba(216, 183, 111, 0.42);
  color: #f4df9c;
  background: rgba(216, 183, 111, 0.08);
  font-size: 25rpx;
  font-weight: 800;
}

.simulation-console {
  position: relative;
  z-index: 1;
  margin-top: 22rpx;
  padding: 20rpx;
  box-sizing: border-box;
  overflow: hidden;
  border: 1rpx solid rgba(216, 183, 111, 0.16);
  border-radius: 22rpx;
  background:
    linear-gradient(135deg, rgba(216, 183, 111, 0.07), rgba(95, 132, 117, 0.055)),
    rgba(5, 9, 8, 0.36);
}

.simulation-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

.simulation-head > view {
  min-width: 0;
}

.simulation-head text {
  display: block;
  color: rgba(216, 183, 111, 0.8);
  font-size: 21rpx;
  font-weight: 900;
  letter-spacing: 0.16em;
}

.simulation-head view view {
  margin-top: 8rpx;
  color: rgba(244, 235, 221, 0.62);
  font-size: 22rpx;
  line-height: 1.4;
}

.emotion-badge {
  flex: 0 0 auto;
  min-width: 74rpx;
  max-width: 132rpx;
  height: 48rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  display: grid;
  place-items: center;
  overflow: hidden;
  border-radius: 999rpx;
  color: #14140f !important;
  background: rgba(216, 183, 111, 0.88);
  font-size: 21rpx !important;
  letter-spacing: 0 !important;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.risk-hint,
.coach-hint,
.decision-prompt {
  margin-top: 16rpx;
  color: rgba(244, 235, 221, 0.62);
  font-size: 23rpx;
  line-height: 1.5;
}

.risk-hint {
  padding: 14rpx 16rpx;
  border-left: 4rpx solid rgba(95, 132, 117, 0.62);
  border-radius: 0 16rpx 16rpx 0;
  background: rgba(95, 132, 117, 0.08);
}

.risk-hint.required {
  border-left-color: rgba(216, 183, 111, 0.72);
  color: rgba(255, 246, 230, 0.8);
  background: rgba(216, 183, 111, 0.08);
}

.runtime-metrics {
  margin-top: 14rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
}

.runtime-metrics > view {
  min-width: 0;
  padding: 12rpx 10rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(244, 235, 221, 0.08);
  background: rgba(255, 255, 255, 0.026);
}

.runtime-metrics text {
  display: block;
  color: rgba(216, 183, 111, 0.56);
  font-size: 18rpx;
  font-weight: 900;
  line-height: 1.2;
}

.runtime-metrics view view {
  margin-top: 6rpx;
  color: rgba(244, 235, 221, 0.76);
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.22;
}

.coach-hint {
  color: rgba(216, 183, 111, 0.72);
}

.decision-prompt {
  color: rgba(244, 235, 221, 0.48);
  font-size: 21rpx;
}

.decision-actions {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
}

.decision-action {
  width: 100%;
  box-sizing: border-box;
}

.decision-btn {
  width: 100%;
  min-width: 0;
  min-height: 72rpx;
  margin: 0;
  padding: 0 6rpx;
  display: grid;
  align-content: center;
  justify-items: center;
  border-radius: 16rpx;
  border: 1rpx solid rgba(244, 235, 221, 0.1);
  color: rgba(244, 235, 221, 0.72);
  background: rgba(255, 255, 255, 0.035);
  line-height: 1.2;
  text-align: center;
  box-sizing: border-box;
}

.decision-btn text {
  color: inherit;
  font-size: 21rpx;
  font-weight: 900;
}

.decision-btn view {
  display: none;
}

.decision-btn.BUY,
.decision-btn.SELL {
  border-color: rgba(216, 183, 111, 0.16);
  background: rgba(216, 183, 111, 0.05);
}

.decision-btn.HOLD {
  border-color: rgba(95, 132, 117, 0.18);
  background: rgba(95, 132, 117, 0.07);
}

.runtime-next {
  width: 100%;
  min-height: 78rpx;
  margin-top: 16rpx;
  display: grid;
  place-items: center;
  border-radius: 999rpx;
  border: 1rpx solid rgba(216, 183, 111, 0.42);
  color: #14140f;
  background:
    linear-gradient(180deg, rgba(255, 247, 207, 0.82), rgba(216, 183, 111, 0.96)),
    #d8b76f;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.2;
}

.runtime-next.locked {
  color: rgba(244, 235, 221, 0.66);
  border-color: rgba(244, 235, 221, 0.12);
  background: rgba(255, 255, 255, 0.035);
}

.indicator-layer {
  position: relative;
  z-index: 1;
  margin-top: 22rpx;
  padding: 18rpx;
  display: grid;
  gap: 14rpx;
  border: 1rpx solid rgba(95, 132, 117, 0.18);
  border-radius: 22rpx;
  background:
    linear-gradient(90deg, rgba(95, 132, 117, 0.1), rgba(255, 255, 255, 0.026)),
    rgba(255, 255, 255, 0.028);
}

.indicator-title {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  align-items: flex-start;
}

.indicator-title text {
  color: rgba(216, 183, 111, 0.78);
  font-size: 21rpx;
  font-weight: 900;
  letter-spacing: 0.14em;
}

.indicator-title view {
  max-width: 360rpx;
  color: rgba(244, 235, 221, 0.46);
  font-size: 20rpx;
  line-height: 1.42;
  text-align: right;
}

.indicator-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
}

.indicator-chip {
  min-height: 84rpx;
  padding: 14rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(244, 235, 221, 0.1);
  background: rgba(5, 9, 8, 0.28);
}

.indicator-chip text {
  display: block;
  color: rgba(244, 235, 221, 0.86);
  font-size: 23rpx;
  font-weight: 900;
}

.indicator-chip view {
  margin-top: 6rpx;
  color: rgba(244, 235, 221, 0.48);
  font-size: 19rpx;
  line-height: 1.35;
}

.slice-playbook {
  position: relative;
  z-index: 1;
  margin-top: 22rpx;
  padding: 20rpx;
  display: grid;
  gap: 12rpx;
  border: 1rpx solid rgba(216, 183, 111, 0.12);
  border-radius: 20rpx;
  background:
    linear-gradient(90deg, rgba(95, 132, 117, 0.11), rgba(255, 255, 255, 0.024)),
    rgba(255, 255, 255, 0.032);
}

.slice-playbook-title {
  color: rgba(216, 183, 111, 0.76);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.16em;
}

.slice-playbook-step {
  display: grid;
  grid-template-columns: 42rpx 1fr;
  gap: 12rpx;
  align-items: start;
}

.slice-playbook-index {
  width: 42rpx;
  height: 42rpx;
  display: grid;
  place-items: center;
  border-radius: 14rpx;
  color: #14140f;
  background: rgba(216, 183, 111, 0.9);
  font-size: 22rpx;
  font-weight: 900;
}

.slice-playbook-copy {
  color: rgba(244, 235, 221, 0.76);
  font-size: 24rpx;
  line-height: 1.48;
}

.wave-question {
  position: relative;
  z-index: 1;
  margin-top: 26rpx;
  padding: 24rpx;
  border-left: 4rpx solid rgba(216, 183, 111, 0.52);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.04);
}

.wave-question text {
  color: #d8b76f;
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 0.18em;
}

.wave-question .guardrail {
  margin-top: 16rpx;
  color: rgba(244, 235, 221, 0.46);
  font-size: 22rpx;
  line-height: 1.5;
  letter-spacing: 0;
}

.wave-question view {
  margin-top: 10rpx;
  color: rgba(255, 246, 230, 0.88);
  font-family: "ZX-LXGW", "LXGW WenKai", "霞鹜文楷", "Songti SC", serif;
  font-size: 32rpx;
  line-height: 1.62;
}

.practice-card,
.method-card,
.prescription-card,
.gate-card,
.completion-card {
  margin-top: 28rpx;
  padding: 30rpx 28rpx;
}

.guide-toggle {
  margin-top: 22rpx;
}

.guide-toggle button {
  width: 100%;
  line-height: 1.2;
  text-align: center;
}

.practice-title,
.method-title,
.prescription-title,
.gate-title {
  position: relative;
  z-index: 1;
  margin-top: 10rpx;
  color: #fff6e6;
  font-family: "ZX-LXGW", "LXGW WenKai", "霞鹜文楷", "Songti SC", serif;
  font-size: 40rpx;
  line-height: 1.3;
}

.method-list {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
  display: grid;
  gap: 16rpx;
}

.method-row {
  min-height: 150rpx;
  display: grid;
  grid-template-columns: 58rpx 1fr;
  gap: 18rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(244, 235, 221, 0.1);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.038);
}

.method-row.firecracker {
  border-color: rgba(216, 183, 111, 0.28);
  background:
    radial-gradient(circle at 18% 0%, rgba(216, 183, 111, 0.12), transparent 45%),
    rgba(255, 255, 255, 0.04);
}

.method-index {
  width: 58rpx;
  height: 58rpx;
  display: grid;
  place-items: center;
  border-radius: 18rpx;
  color: #15150f;
  background: rgba(216, 183, 111, 0.92);
  font-size: 24rpx;
  font-weight: 900;
}

.method-copy text {
  display: block;
  color: #fff6e6;
  font-size: 29rpx;
  font-weight: 900;
}

.method-copy > view {
  margin-top: 8rpx;
  color: rgba(244, 235, 221, 0.62);
  font-size: 24rpx;
  line-height: 1.5;
}

.method-copy .method-focus {
  color: rgba(216, 183, 111, 0.78);
  font-size: 23rpx;
  font-weight: 800;
}

.method-steps {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.method-steps text {
  min-height: 46rpx;
  padding: 0 16rpx;
  display: grid;
  place-items: center;
  border: 1rpx solid rgba(244, 235, 221, 0.1);
  border-radius: 999rpx;
  color: rgba(244, 235, 221, 0.68);
  background: rgba(5, 9, 8, 0.28);
  font-size: 21rpx;
  font-weight: 800;
}

.field-block {
  position: relative;
  z-index: 1;
  margin-top: 30rpx;
}

.field-hint {
  margin-top: 10rpx;
  color: rgba(247, 239, 223, 0.58);
  font-size: 24rpx;
  line-height: 1.55;
}

.first-thought-focus,
.reaction-detail-tags,
.record-depth-fields {
  position: relative;
  z-index: 1;
}

.reaction-direction-row {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: 1fr;
  gap: 12rpx;
}

.reaction-direction-pill {
  width: 100%;
  min-width: 0;
  min-height: 122rpx;
  margin: 0;
  padding: 16rpx 12rpx;
  display: grid;
  align-content: center;
  justify-items: center;
  box-sizing: border-box;
  border-radius: 24rpx;
  color: rgba(244, 235, 221, 0.74);
  border: 1rpx solid rgba(244, 235, 221, 0.12);
  background: rgba(255, 255, 255, 0.035);
  line-height: 1.2;
  text-align: center;
}

.reaction-direction-pill text {
  color: inherit;
  font-size: 25rpx;
  font-weight: 900;
}

.reaction-direction-pill view {
  margin-top: 8rpx;
  color: rgba(244, 235, 221, 0.46);
  font-size: 19rpx;
  line-height: 1.35;
}

.reaction-direction-pill.active {
  color: #13140f;
  border-color: rgba(216, 183, 111, 0.75);
  background:
    linear-gradient(180deg, rgba(255, 247, 207, 0.72), rgba(216, 183, 111, 0.96)),
    #d8b76f;
}

.reaction-direction-pill.active view {
  color: rgba(19, 20, 15, 0.66);
}

.reaction-detail-tags {
  margin-top: 2rpx;
}

.record-depth-fields {
  margin-top: 10rpx;
  padding-top: 2rpx;
}

.compact-field {
  margin-top: 18rpx;
}

.field-mini-toggle {
  position: relative;
  z-index: 1;
  margin-top: 16rpx;
}

.field-mini-toggle button {
  width: 100%;
  min-height: 58rpx;
  font-size: 21rpx;
  line-height: 1.2;
  text-align: center;
}

.option-grid {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  max-width: 100%;
  box-sizing: border-box;
}

.option-grid.boundary {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.option-pill {
  width: 100%;
  min-width: 0;
  min-height: 76rpx;
  margin: 0;
  padding: 0 18rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(244, 235, 221, 0.12);
  border-radius: 999rpx;
  color: rgba(244, 235, 221, 0.72);
  background: rgba(255, 255, 255, 0.04);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.2;
  text-align: center;
  overflow-wrap: anywhere;
}

.option-pill text {
  position: relative;
  z-index: 2;
  color: inherit;
}

.option-pill.seal {
  min-height: 72rpx;
  font-family: "ZX-LXGW", "LXGW WenKai", "霞鹜文楷", "Songti SC", serif;
  font-size: 31rpx;
}

.option-pill.active {
  color: #13140f;
  border-color: rgba(216, 183, 111, 0.75);
  background:
    linear-gradient(180deg, rgba(255, 247, 207, 0.72), rgba(216, 183, 111, 0.96)),
    #d8b76f;
}

.insight-textarea {
  width: 100%;
  min-height: 176rpx;
  margin-top: 16rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(244, 235, 221, 0.12);
  border-radius: 20rpx;
  color: #fff6e6;
  background: rgba(5, 9, 8, 0.5);
  font-size: 28rpx;
  line-height: 1.58;
}

.save-btn {
  position: relative;
  z-index: 1;
  margin-top: 30rpx;
  line-height: 1.2;
}

.completion-card {
  overflow: hidden;
  border-color: rgba(95, 132, 117, 0.24);
  background:
    radial-gradient(circle at 88% 0%, rgba(95, 132, 117, 0.14), transparent 42%),
    rgba(255, 255, 255, 0.035);
}

.completion-mark {
  width: 68rpx;
  height: 68rpx;
  display: grid;
  place-items: center;
  border-radius: 50%;
  color: rgba(255, 236, 205, 0.92);
  border: 2rpx solid rgba(154, 73, 48, 0.66);
  background: rgba(120, 60, 45, 0.32);
  font-family: "ZX-LXGW", "LXGW WenKai", "霞鹜文楷", "Songti SC", serif;
  font-size: 32rpx;
  transform: rotate(-8deg);
}

.completion-card > view:nth-child(2) {
  margin-top: 18rpx;
}

.completion-card > view:nth-child(2) > text {
  display: block;
  color: rgba(244, 235, 221, 0.92);
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.35;
}

.completion-card > view:nth-child(2) > view {
  margin-top: 8rpx;
  color: rgba(244, 235, 221, 0.62);
  font-size: 24rpx;
  line-height: 1.5;
}

.completion-card > text {
  display: block;
  margin-top: 16rpx;
  color: rgba(244, 235, 221, 0.48);
  font-size: 21rpx;
  line-height: 1.5;
}

.bookmark-panel {
  margin-top: 18rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(216, 183, 111, 0.15);
  border-radius: 18rpx;
  background: rgba(5, 9, 8, 0.26);
}

.bookmark-panel text {
  display: block;
  color: rgba(216, 183, 111, 0.82);
  font-size: 22rpx;
  font-weight: 900;
}

.completion-card .bookmark-panel view view {
  margin-top: 6rpx;
  color: rgba(244, 235, 221, 0.58);
  font-size: 21rpx;
  line-height: 1.45;
}

.bookmark-actions {
  margin-top: 14rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
}

.completion-actions {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.completion-review-btn {
  grid-column: 1 / -1;
}

.path-links {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.prescription-grid {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
  display: grid;
  gap: 16rpx;
}

.prescription-grid > view {
  padding: 22rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.04);
}

.prescription-grid view view {
  margin-top: 10rpx;
  color: rgba(255, 246, 230, 0.8);
  font-size: 27rpx;
  line-height: 1.6;
}

.drill-card {
  position: relative;
  z-index: 1;
  margin-top: 22rpx;
  padding: 24rpx;
  border-left: 4rpx solid rgba(95, 132, 117, 0.72);
  border-radius: 18rpx;
  background: rgba(95, 132, 117, 0.08);
}

.drill-card text {
  display: block;
  color: #86b4a1;
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 0.16em;
}

.drill-card view {
  margin-top: 10rpx;
  color: rgba(255, 246, 230, 0.78);
  font-size: 26rpx;
  line-height: 1.56;
}

.gate-list {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
  display: grid;
  gap: 12rpx;
}

.gate-row {
  min-height: 106rpx;
  display: grid;
  grid-template-columns: 72rpx 1fr;
  gap: 18rpx;
  align-items: center;
  padding: 18rpx;
  border: 1rpx solid rgba(244, 235, 221, 0.1);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.032);
}

.gate-row.active {
  border-color: rgba(216, 183, 111, 0.34);
  background: rgba(216, 183, 111, 0.08);
}

.gate-seal {
  width: 72rpx;
  height: 72rpx;
  display: grid;
  place-items: center;
  border-radius: 22rpx;
  color: rgba(244, 235, 221, 0.68);
  border: 1rpx solid rgba(244, 235, 221, 0.12);
  font-family: "ZX-LXGW", "LXGW WenKai", "霞鹜文楷", "Songti SC", serif;
  font-size: 34rpx;
}

.gate-row.active .gate-seal {
  color: #14140f;
  border-color: rgba(216, 183, 111, 0.5);
  background: #d8b76f;
}

.gate-row text {
  display: block;
  color: #fff6e6;
  font-size: 28rpx;
  font-weight: 900;
}

.gate-row view view {
  margin-top: 8rpx;
  color: rgba(244, 235, 221, 0.6);
  font-size: 24rpx;
  line-height: 1.48;
}

.gate-row view .gate-check {
  color: rgba(216, 183, 111, 0.72);
  font-size: 22rpx;
}

.completion-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.completion-card > view,
.completion-card > text {
  position: relative;
  z-index: 1;
}

.completion-card view view {
  margin-top: 8rpx;
  color: #f1d27d;
  font-size: 64rpx;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
}

.completion-card > text {
  flex: 1;
  color: rgba(244, 235, 221, 0.6);
  font-size: 24rpx;
  line-height: 1.55;
}

@media (max-width: 340px) {
  .hero-meta,
  .market-rail,
  .reaction-direction-row,
  .option-grid {
    grid-template-columns: 1fr;
  }

  .wave-source-line {
    align-items: flex-start;
    flex-direction: column;
  }

  .wave-source-detail {
    text-align: left;
  }

  .option-grid.boundary {
    grid-template-columns: 1fr;
  }

  .kline-hero .page-title {
    font-size: 56rpx;
  }

  .completion-card {
    align-items: flex-start;
    flex-direction: column;
  }
}
