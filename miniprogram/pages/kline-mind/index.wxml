<view class="page-shell kline-page">
  <view class="ink-depth"></view>
  <view class="page-content">
    <view class="kline-hero">
      <view class="hero-topline">
        <text>K LINE MIND</text>
        <view>{{savedRecord && savedRecord.completed ? '已观心' : '待观心'}}</view>
      </view>

      <view class="page-title">今日观心</view>
      <view class="page-subtitle">看一段历史片段，先记录第一反应；不连接实时数据，不做当下判断。</view>
      <view class="kline-one-thing">
        <text>今日只练</text>
        <view>{{session.prescription.boundaryPractice}}</view>
      </view>

      <view wx:if="{{false}}" class="hero-meta">
        <view>
          <text>今日</text>
          <view>Day {{session.day}} · {{trainingDay.title}}</view>
        </view>
        <view>
          <text>人格处方</text>
          <view>{{session.personalityType}}</view>
        </view>
        <view>
          <text>主修关口</text>
          <view>{{session.stageGate.order}} · {{session.stageGate.name}}</view>
        </view>
      </view>

    </view>

    <view class="mind-wave card">
      <view class="wave-head">
        <view>
          <text>K线盲练</text>
          <view>{{session.subtitle}}</view>
        </view>
      </view>

      <view wx:if="{{false}}" class="wave-source-line">
        <text>观心片段</text>
        <view class="wave-source-detail">{{session.market.rhythm}} · {{session.dataStatusText}}</view>
      </view>

      <view class="chart-toolbar">
        <view class="chart-toolbar-row">
          <view class="chart-period-rail">
            <text>交易风格</text>
            <button
              wx:for="{{session.timeframeOptions}}"
              wx:key="key"
              class="timeframe-chip {{item.selected ? 'active' : ''}}"
              data-timeframe="{{item.key}}"
              bindtap="selectTimeframe"
            >
              {{item.label}}
            </button>
          </view>
          <button
            class="slice-change-btn {{sliceSwitchLocked || historyLoading ? 'disabled' : ''}}"
            disabled="{{sliceSwitchLocked || historyLoading}}"
            bindtap="switchSlice"
          >
            换一段
          </button>
        </view>
        <view class="chart-orientation-note">横屏训练更稳</view>
      </view>

      <view wx:if="{{session.hasHistoricalData}}" class="chart-canvas-wrap">
        <view class="chart-stepper">
          <view class="chart-stepper-control" bindtap="decreaseChartZoom">-</view>
          <view class="chart-stepper-control" bindtap="increaseChartZoom">+</view>
        </view>
        <view
          class="wave-board-scroll"
          bindtouchstart="onChartPanStart"
          bindtouchmove="onChartPanMove"
          bindtouchend="onChartPanEnd"
          bindtouchcancel="onChartPanEnd"
        >
          <view class="chart-scroll-inner" style="{{runtimeView.chartBoardStyle}}">
            <view class="wave-board zoom-{{session.chartZoomKey}}">
              <view class="wave-board-content">
                <view class="indicator-lines">
                  <view wx:for="{{runtimeView.indicatorOverlay.bollUpper}}" wx:key="key" class="indicator-segment boll" style="{{item.style}}"></view>
                  <view wx:for="{{runtimeView.indicatorOverlay.bollLower}}" wx:key="key" class="indicator-segment boll" style="{{item.style}}"></view>
                  <view wx:for="{{runtimeView.indicatorOverlay.ma20}}" wx:key="key" class="indicator-segment ma20" style="{{item.style}}"></view>
                  <view wx:for="{{runtimeView.indicatorOverlay.ma10}}" wx:key="key" class="indicator-segment ma10" style="{{item.style}}"></view>
                  <view wx:for="{{runtimeView.indicatorOverlay.ma5}}" wx:key="key" class="indicator-segment ma5" style="{{item.style}}"></view>
                </view>
                <button
                  wx:for="{{runtimeView.visibleCandles}}"
                  wx:key="key"
                  class="mind-candle {{item.tone}} {{item.focus ? 'focus' : ''}} {{item.selected ? 'selected' : ''}}"
                  data-key="{{item.key}}"
                  bindtap="selectCandle"
                >
                  <view class="wick" style="{{item.wickStyle}}"></view>
                  <view class="body" style="{{item.bodyStyle}}"></view>
                </button>
              </view>
            </view>

            <view class="indicator-strip-spacer"></view>

            <view wx:if="{{runtimeView.indicatorPanel.visible}}" class="sub-indicator-board {{runtimeView.indicatorPanel.type}} zoom-{{session.chartZoomKey}}">
              <view class="sub-indicator-content">
                <view wx:for="{{runtimeView.indicatorPanel.lines.upper}}" wx:key="key" class="sub-line boll-upper" style="{{item.style}}"></view>
                <view wx:for="{{runtimeView.indicatorPanel.lines.lower}}" wx:key="key" class="sub-line boll-lower" style="{{item.style}}"></view>
                <view wx:for="{{runtimeView.indicatorPanel.lines.mid}}" wx:key="key" class="sub-line boll-mid" style="{{item.style}}"></view>
                <view wx:for="{{runtimeView.indicatorPanel.lines.dif}}" wx:key="key" class="sub-line dif" style="{{item.style}}"></view>
                <view wx:for="{{runtimeView.indicatorPanel.lines.dea}}" wx:key="key" class="sub-line dea" style="{{item.style}}"></view>
                <view wx:for="{{runtimeView.indicatorPanel.lines.rsi}}" wx:key="key" class="sub-line rsi" style="{{item.style}}"></view>
                <view wx:for="{{runtimeView.indicatorPanel.lines.k}}" wx:key="key" class="sub-line k" style="{{item.style}}"></view>
                <view wx:for="{{runtimeView.indicatorPanel.lines.d}}" wx:key="key" class="sub-line d" style="{{item.style}}"></view>
                <view wx:for="{{runtimeView.indicatorPanel.lines.j}}" wx:key="key" class="sub-line j" style="{{item.style}}"></view>
                <view
                  wx:for="{{runtimeView.indicatorPanel.items}}"
                  wx:key="key"
                  class="sub-indicator-item {{item.tone}}"
                >
                  <view class="sub-bar" style="{{item.barStyle}}"></view>
                </view>
              </view>
            </view>
          </view>
        </view>
        <view class="indicator-strip">
          <view
            wx:for="{{session.mainIndicatorOptions}}"
            wx:for-item="mainIndicator"
            wx:key="key"
            class="chart-indicator-chip {{mainIndicator.key === selectedMainIndicatorKey ? 'active' : ''}}"
            data-indicator="{{mainIndicator.key}}"
            bindtap="selectMainIndicator"
          >
            {{mainIndicator.label}}
          </view>
          <view class="indicator-divider"></view>
          <view
            wx:for="{{session.indicatorPanelOptions}}"
            wx:for-item="subIndicator"
            wx:key="key"
            class="chart-indicator-chip {{subIndicator.key === selectedIndicatorKey ? 'active' : ''}}"
            data-indicator="{{subIndicator.key}}"
            bindtap="selectIndicator"
          >
            {{subIndicator.label}}
          </view>
        </view>
      </view>
      <view wx:else class="history-empty">
        <view>{{historyLoading ? '正在读取历史数据' : '历史数据未载入'}}</view>
        <text>{{historyLoading ? '正在从服务器读取真实历史片段。' : '请先同步真实历史数据；未载入前不展示占位 K线。'}}</text>
      </view>

      <view wx:if="{{trainingRuntime && runtimeView.visibleCandles.length}}" class="simulation-console">
        <view class="simulation-head">
          <view>
            <text>逐根盲练</text>
            <view>{{runtimeView.progressText}} · 已记 {{runtimeView.decisionCount}} 次</view>
          </view>
          <text wx:if="{{runtimeView.latestEmotion}}" class="emotion-badge">{{runtimeView.latestEmotion}}</text>
        </view>

        <view class="risk-hint {{runtimeView.mustDecide ? 'required' : ''}}">
          {{runtimeView.latestRisk}}
        </view>
        <view class="runtime-metrics">
          <view>
            <text>仓位</text>
            <view>{{runtimeView.positionText}}</view>
          </view>
          <view>
            <text>盈亏</text>
            <view>{{runtimeView.pnlText}}</view>
          </view>
          <view>
            <text>回撤</text>
            <view>{{runtimeView.drawdownText}}</view>
          </view>
        </view>
        <view class="coach-hint" wx:if="{{runtimeView.latestCoach}}">
          {{runtimeView.latestCoach}}
        </view>
        <view class="decision-prompt">{{runtimeView.decisionPrompt}}</view>

        <view class="decision-actions">
          <view
            wx:for="{{decisionActions}}"
            wx:key="key"
            class="decision-action decision-btn {{item.key}}"
            data-action="{{item.key}}"
            bindtap="recordRuntimeDecision"
          >
            <text>{{item.label}}</text>
          </view>
        </view>

        <button class="runtime-next {{runtimeView.mustDecide ? 'locked' : ''}}" bindtap="advanceRuntimeCandle">
          {{runtimeView.nextButtonText}}
        </button>
      </view>

      <view class="slice-playbook">
        <text class="slice-playbook-title">本段练法</text>
        <view class="slice-playbook-step">
          <text class="slice-playbook-index">1</text>
          <view class="slice-playbook-copy">先停十秒，只看哪一根最牵动你。</view>
        </view>
        <view class="slice-playbook-step">
          <text class="slice-playbook-index">2</text>
          <view class="slice-playbook-copy">点最牵动的一根，写下第一反应。</view>
        </view>
        <view class="slice-playbook-step">
          <text class="slice-playbook-index">3</text>
          <view class="slice-playbook-copy">回到边界，不把历史片段当成当下判断。</view>
        </view>
      </view>

      <view class="wave-question">
        <text>今日观心</text>
        <view>{{session.hasHistoricalData ? session.prompt : session.marketQuestion}}</view>
        <text class="guardrail">{{session.marketGuardrail}}</text>
      </view>
    </view>

    <view class="practice-card card">
      <view class="section-kicker">心念记录</view>
      <view class="practice-title">这一刻，先看见自己</view>

      <view class="first-thought-focus">
        <view class="field-block">
          <text>先问一句</text>
          <view class="field-hint">是看见事实，还是想用行动缓解不安？</view>
          <view class="reaction-direction-row">
            <button
              wx:for="{{reactionDirections}}"
              wx:key="key"
              class="reaction-direction-pill {{form.reactionDirection === item.key ? 'active' : ''}}"
              data-field="reactionDirection"
              data-value="{{item.key}}"
              bindtap="selectOption"
            >
              <text>{{item.label}}</text>
              <view>{{item.detail}}</view>
            </button>
          </view>
        </view>

        <view wx:if="{{form.reactionDirection}}" class="reaction-detail-tags">
          <view class="field-block">
            <text>再给这一念命名</text>
            <view class="option-grid">
              <button
                wx:for="{{session.reactionOptions}}"
                wx:key="*this"
                class="option-pill {{form.firstReaction === item ? 'active' : ''}}"
                data-field="firstReaction"
                data-value="{{item}}"
                bindtap="selectOption"
              >
                <text>{{item}}</text>
              </button>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{form.firstReaction}}" class="record-depth-fields">
      <view class="field-mini-toggle">
        <button class="ghost-btn" bindtap="toggleBodySignal">{{showBodySignal ? '收起身体感受' : '补身体感受'}}</button>
      </view>

      <view wx:if="{{showBodySignal}}" class="field-block compact-field">
        <text>身体感受</text>
        <view class="option-grid compact">
          <button
            wx:for="{{session.bodyOptions}}"
            wx:key="*this"
            class="option-pill seal {{form.bodySignal === item ? 'active' : ''}}"
            data-field="bodySignal"
            data-value="{{item}}"
            bindtap="selectOption"
          >
            <text>{{item}}</text>
          </button>
        </view>
      </view>

      <view class="field-block">
        <text>守界动作</text>
        <view class="option-grid boundary">
          <button
            wx:for="{{session.boundaryOptions}}"
            wx:key="*this"
            class="option-pill {{form.boundaryChoice === item ? 'active' : ''}}"
            data-field="boundaryChoice"
            data-value="{{item}}"
            bindtap="selectOption"
          >
            <text>{{item}}</text>
          </button>
        </view>
      </view>

      <view class="field-block">
        <text>今日照见一句话</text>
        <textarea
          class="insight-textarea"
          maxlength="96"
          placeholder="例：我看见自己不是在看图形，而是在急着缓解不安。"
          value="{{form.insightLine}}"
          bindinput="inputInsight"
        />
      </view>

      <button class="primary-btn save-btn" bindtap="saveRecord">{{savedRecord && savedRecord.completed ? '更新活镜记录' : '写入活镜'}}</button>
      </view>
    </view>

    <view wx:if="{{savedRecord && savedRecord.completed}}" class="completion-card card">
      <view class="completion-mark">照</view>
      <view>
        <text>K 线观心已写入活镜</text>
        <view>{{savedRecord.insightLine}}</view>
      </view>
      <text>只记录第一反应、守界动作与复盘完整度，不关联外在结果。</text>
      <view class="completion-actions">
        <button class="ghost-btn" bindtap="goHome">回今日</button>
        <button class="primary-btn" bindtap="goLivingMirror">看活镜</button>
        <button wx:if="{{tradeReviewUrl}}" class="ghost-btn completion-review-btn" bindtap="goTradeReviewH5">查看本次复盘</button>
      </view>
    </view>

    <view wx:if="{{savedRecord && savedRecord.completed}}" class="path-links">
      <button class="ghost-btn" bindtap="goTraining">7 天训练</button>
      <button wx:if="{{training7View.canRetest}}" class="secondary-btn" bindtap="goRetest">进入复测</button>
      <button wx:else class="secondary-btn" bindtap="goReport">人格报告</button>
    </view>

    <compliance-notice variant="full" />
  </view>
  <bottom-tab-bar active="mind" />
</view>
