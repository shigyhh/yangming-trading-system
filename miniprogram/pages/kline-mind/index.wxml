<view class="page-shell kline-page">
  <view class="ink-depth"></view>
  <view class="page-content">
    <view class="kline-hero">
      <view class="hero-topline">
        <text>K LINE MIND</text>
        <view>{{savedRecord && savedRecord.completed ? '已观心' : '待观心'}}</view>
      </view>

      <view class="page-title">今日 K 线观心</view>
      <view class="page-subtitle">看一段真实历史 K 线，记录第一反应；不连接实时数据，不做当下判断。</view>
      <view class="kline-one-thing">
        <text>今日只练</text>
        <view>{{session.prescription.boundaryPractice}}</view>
      </view>

      <view class="training-entry-panel">
        <view
          class="training-entry-card {{activeTrainingMode === 'review_focus' ? 'active' : ''}}"
          bindtap="startReviewFocusTraining"
        >
          <view class="training-entry-head">
            <text>今日针对训练</text>
            <view>{{reviewFocus ? '已关联复盘错题' : '从复盘错题进入'}}</view>
          </view>
          <view class="training-entry-main">{{reviewFocusErrorType || '根据真实复盘生成'}}</view>
          <view class="training-entry-meta">下次执行动作：{{reviewFocusNextAction || '先记录，再行动'}}</view>
        </view>

        <view class="special-training-section">
          <view class="special-training-title">
            <text>专项训练</text>
            <view>按错题练，不按品种练</view>
          </view>
          <view class="special-training-list">
            <view
              wx:for="{{specialTrainingPacks}}"
              wx:key="id"
              class="special-training-pack {{activeTrainingMode === 'special_training' && session.trainingPackId === item.id ? 'active' : ''}}"
            >
              <view class="special-pack-head">
                <text>{{item.title}}</text>
                <button
                  class="special-pack-start"
                  catchtap="startSpecialTraining"
                  data-pack-id="{{item.id}}"
                >
                  开始训练
                </button>
              </view>
              <view class="special-pack-goal">{{item.trainingGoal}}</view>
              <view class="special-pack-meta">重点场景：{{item.sceneText}}</view>
              <view class="special-pack-meta">下次执行动作：{{item.expectedAction}}</view>
            </view>
          </view>
        </view>

        <view
          class="training-entry-card base {{activeTrainingMode === 'base_blind' ? 'active' : ''}}"
          bindtap="startBaseBlindTraining"
        >
          <view class="training-entry-head">
            <text>基础盲练</text>
            <view>不带复盘标签</view>
          </view>
          <view class="training-entry-main">只看历史片段，记录第一反应。</view>
          <view class="training-entry-meta">下次执行动作：先看事实，再记录第一念。</view>
        </view>

        <view class="custom-training-section {{activeTrainingMode === 'custom_session' ? 'active' : ''}}">
          <view class="special-training-title">
            <text>自选盲练</text>
            <view>自选标的与时间段</view>
          </view>
          <view class="custom-form-grid">
            <view class="custom-field">
              <text>标的代码</text>
              <input
                value="{{customSessionForm.symbol}}"
                data-field="symbol"
                bindinput="inputCustomSessionField"
                placeholder="例：000001.SZ"
              />
            </view>
            <view class="custom-field">
              <text>训练长度</text>
              <input
                type="number"
                value="{{customSessionForm.trainingLength}}"
                data-field="trainingLength"
                bindinput="inputCustomSessionField"
                placeholder="60"
              />
            </view>
          </view>
          <view class="custom-period-rail">
            <button
              wx:for="{{session.timeframeOptions}}"
              wx:key="key"
              class="{{customSessionForm.period === item.key ? 'active' : ''}}"
              data-period="{{item.key}}"
              bindtap="selectCustomPeriod"
            >
              {{item.label}}
            </button>
          </view>
          <view class="custom-form-grid">
            <view class="custom-field">
              <text>起始日期</text>
              <input
                value="{{customSessionForm.startDate}}"
                data-field="startDate"
                bindinput="inputCustomSessionField"
                placeholder="YYYY-MM-DD"
              />
            </view>
            <view class="custom-field">
              <text>结束日期</text>
              <input
                value="{{customSessionForm.endDate}}"
                data-field="endDate"
                bindinput="inputCustomSessionField"
                placeholder="YYYY-MM-DD"
              />
            </view>
          </view>
          <button class="custom-start-btn" bindtap="startCustomBlindTraining">开始自选盲练</button>
          <view wx:if="{{customSessionStatusText}}" class="custom-status">
            <text>{{customSessionStatusText}}</text>
            <view>{{customSessionMessage || customSessionError}}</view>
          </view>
        </view>
      </view>

      <view wx:if="{{samplingStatusText}}" class="sampling-status {{samplingStatus}}">
        <text>{{samplingStatusText}}</text>
        <view>{{samplingMessage || samplingError}}</view>
      </view>

      <view wx:if="{{false}}" class="hero-meta">
        <view>
          <text>今日</text>
          <view>Day {{session.day}} · {{trainingDay.title}}</view>
        </view>
        <view>
          <text>人格处方</text>
          <view>{{session.personalityType}}</view>
        </view>
        <view>
          <text>主修关口</text>
          <view>{{session.stageGate.order}} · {{session.stageGate.name}}</view>
        </view>
      </view>

      <view class="slice-switch">
        <view>
          <text>{{activeTrainingMode === 'custom_session' ? '自选盲练 · ' + session.timeframeLabel : session.market.name + ' · ' + session.timeframeLabel}}</text>
          <view>{{activeTrainingMode === 'custom_session' ? session.customDateRangeText : session.market.rule}}</view>
        </view>
        <button bindtap="toggleSelectors">{{showSelectors ? '收起' : '切换'}}</button>
      </view>

      <view wx:if="{{showSelectors}}" class="market-rail">
        <button
          wx:for="{{session.marketOptions}}"
          wx:key="key"
          class="market-chip {{item.selected ? 'active' : ''}}"
          data-market="{{item.key}}"
          bindtap="selectMarket"
        >
          <text>{{item.name}}</text>
          <view>{{item.rhythm}}</view>
        </button>
      </view>

      <view wx:if="{{showSelectors}}" class="timeframe-rail">
        <button
          wx:for="{{session.timeframeOptions}}"
          wx:key="key"
          class="timeframe-chip {{item.selected ? 'active' : ''}}"
          data-timeframe="{{item.key}}"
          bindtap="selectTimeframe"
        >
          {{item.label}}
        </button>
      </view>
    </view>

    <view class="mind-wave card">
      <view class="wave-head">
        <view>
          <text>{{session.market.name}} · {{session.market.triggerLabel}}</text>
          <view>{{session.subtitle}}</view>
        </view>
        <text>{{session.stageGate.seal}}</text>
      </view>

      <view class="sim-meta">
        <view>
          <text>{{activeTrainingMode === 'custom_session' ? '盲练进度' : '市场节奏'}}</text>
          <view>{{activeTrainingMode === 'custom_session' ? session.customProgressText : session.market.rhythm + ' · ' + session.market.rule}}</view>
        </view>
        <view>
          <text>数据状态</text>
          <view>{{activeTrainingMode === 'custom_session' ? session.dataStatusText + ' · ' + session.customSymbolText : session.dataStatusText + ' · ' + session.market.defaultSymbol}}</view>
        </view>
      </view>

      <view wx:if="{{session.hasHistoricalData}}" class="wave-board">
        <button
          wx:for="{{session.candles}}"
          wx:key="key"
          class="mind-candle {{item.tone}} {{item.focus ? 'focus' : ''}} {{item.selected ? 'selected' : ''}}"
          data-key="{{item.key}}"
          bindtap="selectCandle"
        >
          <view class="wick" style="{{item.wickStyle}}"></view>
          <view class="body" style="{{item.bodyStyle}}"></view>
          <view class="volume" style="{{item.volumeStyle}}"></view>
          <text wx:if="{{item.label}}">{{item.label}}</text>
        </button>
      </view>
      <view wx:else class="history-empty">
        <view>历史数据未载入</view>
        <text>请先同步真实历史数据；未载入前不展示占位 K线。</text>
      </view>

      <view class="wave-question">
        <text>今日观心</text>
        <view>{{session.hasHistoricalData ? session.prompt : session.marketQuestion}}</view>
        <text class="guardrail">{{session.marketGuardrail}}</text>
      </view>

      <view wx:if="{{activeTrainingMode === 'custom_session' && session.hasHistoricalData}}" class="custom-action-panel">
        <view>
          <text>{{session.customProgressText}}</text>
          <view>训练中隐藏真实标的和日期，只按当前图形记录动作。</view>
        </view>
        <view class="custom-action-buttons">
          <button data-action="买入" bindtap="advanceCustomSession">买入</button>
          <button data-action="卖出" bindtap="advanceCustomSession">卖出</button>
          <button data-action="观望" bindtap="advanceCustomSession">观望</button>
        </view>
      </view>
    </view>

    <view class="guide-toggle">
      <button class="ghost-btn" bindtap="toggleGuide">{{showGuide ? '收起训练说明' : '查看训练说明'}}</button>
    </view>

    <view wx:if="{{showGuide}}" class="method-card card">
      <view class="section-kicker">TRAINING SYSTEM</view>
      <view class="method-title">训练方法详解</view>
      <view class="method-list">
        <view wx:for="{{session.trainingMethods}}" wx:key="key" class="method-row {{item.key === 'firecracker' ? 'firecracker' : ''}}">
          <view class="method-index">{{index + 1}}</view>
          <view class="method-copy">
            <text>{{item.title}}</text>
            <view>{{item.subtitle}}</view>
            <view class="method-focus">{{item.focus}}</view>
            <view class="method-steps">
              <text wx:for="{{item.steps}}" wx:for-item="step" wx:key="*this">{{step}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="practice-card card">
      <view class="section-kicker">MIND RECORD</view>
      <view class="practice-title">这一刻，先看见自己</view>
      <view class="practice-flow">
        <text>选一念</text>
        <text>守一界</text>
        <text>写一句</text>
      </view>

      <view class="field-block">
        <text>第一反应</text>
        <view class="option-grid">
          <button
            wx:for="{{session.reactionOptions}}"
            wx:key="*this"
            class="option-pill {{form.firstReaction === item ? 'active' : ''}}"
            data-field="firstReaction"
            data-value="{{item}}"
            bindtap="selectOption"
          >
            <text>{{item}}</text>
          </button>
        </view>
      </view>

      <view class="field-mini-toggle">
        <button class="ghost-btn" bindtap="toggleBodySignal">{{showBodySignal ? '收起身体感受' : '补身体感受'}}</button>
      </view>

      <view wx:if="{{showBodySignal}}" class="field-block compact-field">
        <text>身体感受</text>
        <view class="option-grid compact">
          <button
            wx:for="{{session.bodyOptions}}"
            wx:key="*this"
            class="option-pill seal {{form.bodySignal === item ? 'active' : ''}}"
            data-field="bodySignal"
            data-value="{{item}}"
            bindtap="selectOption"
          >
            <text>{{item}}</text>
          </button>
        </view>
      </view>

      <view class="field-block">
        <text>守界动作</text>
        <view class="option-grid boundary">
          <button
            wx:for="{{session.boundaryOptions}}"
            wx:key="*this"
            class="option-pill {{form.boundaryChoice === item ? 'active' : ''}}"
            data-field="boundaryChoice"
            data-value="{{item}}"
            bindtap="selectOption"
          >
            <text>{{item}}</text>
          </button>
        </view>
      </view>

      <view class="field-block">
        <text>今日照见一句话</text>
        <textarea
          class="insight-textarea"
          maxlength="96"
          placeholder="例：我看见自己不是在看图形，而是在急着缓解不安。"
          value="{{form.insightLine}}"
          bindinput="inputInsight"
        />
      </view>

      <button class="primary-btn save-btn" bindtap="saveRecord">{{savedRecord && savedRecord.completed ? '更新活镜记录' : '写入活镜'}}</button>
    </view>

    <view wx:if="{{showGuide}}" class="prescription-card card">
      <view class="section-kicker">PERSONAL PATH</view>
      <view class="prescription-title">{{session.prescription.title}}</view>
      <view class="drill-card">
        <text>九型专练动作</text>
        <view>{{session.personalityDrill.targetScene}}</view>
        <view>{{session.personalityDrill.drillAction}}</view>
        <view>{{session.personalityDrill.reviewPrompt}}</view>
      </view>
      <view class="prescription-grid">
        <view>
          <text>当前心贼</text>
          <view>{{session.prescription.heartThief}}</view>
        </view>
        <view>
          <text>最易被牵动处</text>
          <view>{{session.prescription.watchPoint}}</view>
        </view>
        <view>
          <text>第一问</text>
          <view>{{session.prescription.firstQuestion}}</view>
        </view>
        <view>
          <text>今日克治</text>
          <view>{{session.prescription.boundaryPractice}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{showGuide}}" class="gate-card card">
      <view class="section-kicker">SIX GATES</view>
      <view class="gate-title">六大关口训练地图</view>
      <view class="gate-list">
        <view wx:for="{{session.gates}}" wx:key="key" class="gate-row {{item.active ? 'active' : ''}}">
          <view class="gate-seal">{{item.seal}}</view>
          <view>
            <text>{{item.order}} · {{item.name}} · {{item.title}}</text>
            <view>{{item.trainingAction}}</view>
            <view class="gate-check">{{item.passCheck}}</view>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{savedRecord && savedRecord.completed}}" class="completion-card card">
      <view class="completion-mark">照</view>
      <view>
        <text>K 线观心已写入活镜</text>
        <view>{{savedRecord.insightLine}}</view>
      </view>
      <view class="execution-summary">
        <view>
          <text>执行结果</text>
          <view>{{savedRecord.executionResult || savedRecord.execution_result || '说不清'}}</view>
        </view>
        <view>
          <text>本局执行一致率</text>
          <view>{{savedRecord.executionConsistencyRateText || savedRecord.execution_consistency_rate_text || '样本不足'}}</view>
        </view>
      </view>
      <view wx:if="{{savedRecord.trainingMistakeCard || savedRecord.training_mistake_card}}" class="training-mistake-summary">
        <text>训练错题卡</text>
        <view>{{savedRecord.trainingMistakeCard.errorType || savedRecord.training_mistake_card.error_type || savedRecord.errorType || savedRecord.error_type || '待照见'}}</view>
        <view>执行结果：{{savedRecord.trainingMistakeCard.executionResult || savedRecord.training_mistake_card.execution_result || savedRecord.executionResult || savedRecord.execution_result || '说不清'}}</view>
        <view>本局执行一致率：{{savedRecord.executionConsistencyRateText || savedRecord.execution_consistency_rate_text || '样本不足'}}</view>
      </view>
      <view wx:if="{{savedRecord.samplingResult || savedRecord.sampling_result || savedRecord.segmentId || savedRecord.segment_id}}" class="sampling-summary">
        <text>训练片段来源</text>
        <view>{{savedRecord.samplingSourceLabel || savedRecord.sampling_source_label || (savedRecord.fallbackUsed || savedRecord.fallback_used ? '兜底片段' : '匹配片段')}}</view>
        <view>场景标签：{{savedRecord.samplingSceneTagsText || savedRecord.sampling_scene_tags_text || savedRecord.sceneTags || savedRecord.scene_tags || '待补充'}}</view>
        <view wx:if="{{savedRecord.fallbackReason || savedRecord.fallback_reason}}">兜底原因：{{savedRecord.fallbackReason || savedRecord.fallback_reason}}</view>
      </view>
      <view wx:if="{{savedRecord.sourceType === 'custom_session' || savedRecord.source_type === 'custom_session'}}" class="sampling-summary custom-reveal-summary">
        <text>自选盲练来源</text>
        <view>真实标的：{{savedRecord.revealedSymbolText || savedRecord.revealed_symbol_text || savedRecord.symbol || '待揭示'}}</view>
        <view>真实时间段：{{savedRecord.revealedDateRangeText || savedRecord.revealed_date_range_text || '待揭示'}}</view>
        <view>片段来源：自选盲练</view>
      </view>
      <text>只记录第一反应、守界动作与复盘完整度，不关联外在结果。</text>
      <view class="bookmark-panel">
        <view>
          <text>训练收藏</text>
          <view>{{bookmarkMessage || bookmarkError || '收藏本局或训练错题卡，后续可在我的页只读回放。'}}</view>
        </view>
        <view class="bookmark-actions">
          <button class="ghost-btn" data-bookmark-type="session" bindtap="saveTrainingBookmark" loading="{{bookmarkSaving}}">收藏本局</button>
          <button class="secondary-btn" data-bookmark-type="mistake_card" bindtap="saveTrainingBookmark" loading="{{bookmarkSaving}}">收藏训练错题卡</button>
        </view>
      </view>
      <view class="completion-actions">
        <button class="ghost-btn" bindtap="goHome">回今日</button>
        <button class="primary-btn" bindtap="goLivingMirror">看活镜</button>
      </view>
    </view>

    <view class="path-links">
      <button class="ghost-btn" bindtap="goTraining">7 天训练</button>
      <button wx:if="{{training7View.canRetest}}" class="secondary-btn" bindtap="goRetest">进入复测</button>
      <button wx:else class="secondary-btn" bindtap="goReport">人格报告</button>
    </view>

    <compliance-notice />
  </view>
  <bottom-tab-bar active="mind" />
</view>
