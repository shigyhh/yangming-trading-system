<view class="page-shell">
  <view class="page-content">
    <text class="eyebrow">LIVE MIRROR · 真实复盘</text>
    <view class="page-title">真实复盘</view>
    <view class="page-subtitle">上传一条真实记录，写下第一念；系统把它写入活镜，看见反复出现的念头。</view>

    <view class="concept-bridge card">
      <view class="bridge-line">复盘，是你写下事实。活镜，是系统照见反复出现的念头。</view>
      <view wx:if="{{false}}" class="bridge-steps">
        <view>
          <text>真实复盘</text>
          <view>记录一笔真实交易</view>
        </view>
        <view>
          <text>活镜照见</text>
          <view>沉淀成行为印记</view>
        </view>
        <view>
          <text>心镜档案</text>
          <view>长期保存你的变化</view>
        </view>
      </view>
    </view>

    <view wx:if="{{showAdvanced}}" class="record-flow card">
      <view class="record-flow-head">
        <text>真实记录闭环</text>
        <view>一条记录，走完一次照见</view>
      </view>
      <view class="record-flow-list">
        <view
          wx:for="{{reviewFlow}}"
          wx:key="key"
          class="record-flow-row {{item.done ? 'done' : ''}} {{item.current ? 'current' : ''}}"
        >
          <text>{{item.number}}</text>
          <view>
            <text>{{item.title}}</text>
            <view>{{item.detail}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="upload-card card">
      <text>真实记录</text>
      <view class="upload-preview" wx:if="{{form.screenshotPath}}">
        <image src="{{form.screenshotPath}}" mode="aspectFill" aria-label="交易复盘截图预览" />
      </view>
      <view wx:else class="upload-empty">上传一张交易截图；系统尽量识别日期和股票代码。</view>
      <view class="upload-actions">
        <button class="primary-btn upload-primary" bindtap="chooseImage">{{form.screenshotPath ? '重新上传截图' : '上传交易截图'}}</button>
        <button class="manual-anchor-link" bindtap="showManualAnchor">没有截图，手动填写</button>
      </view>
      <view class="upload-note">{{ocrStatus.text}}</view>
    </view>

    <view wx:if="{{manualAnchorVisible || form.screenshotPath || form.symbol}}" class="anchor-card card">
      <view class="anchor-head">
        <text>确认锚点</text>
        <view class="anchor-status {{marketContextStatus.state}}">{{marketContextStatus.text}}</view>
      </view>

      <view class="field-grid">
        <view>
          <text>买入/记录日期</text>
          <picker mode="date" value="{{form.tradeDate}}" bindchange="changeDate">
            <view>{{form.tradeDate}}</view>
          </picker>
        </view>
        <view>
          <text>股票代码</text>
          <input value="{{form.symbol}}" bindinput="inputSymbol" placeholder="例如：600123" />
        </view>
      </view>

      <view wx:if="{{marketContext && marketContext.status === 'ready'}}" class="anchor-meta">
        {{marketContext.marketLabel}} · {{marketContext.timeframeLabel}} · {{marketContext.candleCount}} 根
      </view>
    </view>

    <view wx:if="{{form.screenshotPath || manualAnchorVisible || form.symbol}}" class="quick-review-card card">
      <text>60 秒真实复盘</text>
      <view>只回答三件事：第一念是什么，是否在计划内，下一次执行什么。</view>

      <view class="quick-label">第一念是什么？</view>
      <view class="quick-choice-grid thought">
        <button
          wx:for="{{firstThoughtOptions}}"
          wx:key="*this"
          class="quick-choice-pill {{form.firstThought === item ? 'active' : ''}}"
          data-value="{{item}}"
          bindtap="selectFirstThought"
        >{{item}}</button>
      </view>

      <view wx:if="{{form.firstThought}}" class="quick-next-step">
        <view class="quick-label">这笔交易是否在原计划内？</view>
        <view class="quick-choice-grid three">
          <button
            wx:for="{{planStateOptions}}"
            wx:key="key"
            class="quick-choice-pill {{form.inPlan === item.key ? 'active' : ''}}"
            data-value="{{item.key}}"
            bindtap="selectPlanState"
          >{{item.label}}</button>
        </view>

        <view class="quick-label">现在这笔是什么状态？</view>
        <view class="quick-choice-grid three">
          <button
            wx:for="{{positionStates}}"
            wx:key="key"
            class="quick-choice-pill {{form.positionState === item.key ? 'active' : ''}}"
            data-key="{{item.key}}"
            bindtap="selectPositionState"
          >{{item.label}}</button>
        </view>

        <view class="quick-label">下一次执行动作？</view>
        <view class="quick-choice-grid next-rule">
          <button
            wx:for="{{nextActionOptions}}"
            wx:key="*this"
            class="quick-choice-pill {{form.nextAction === item ? 'active' : ''}}"
            data-value="{{item}}"
            bindtap="selectNextAction"
          >{{item}}</button>
        </view>

        <textarea class="optional-review-note" value="{{form.reviewNote}}" bindinput="inputNote" placeholder="可选补充一句，不写也可以。" />
      </view>

      <view wx:if="{{showAdvanced}}" class="quick-label">有没有临盘改计划？</view>
      <view wx:if="{{showAdvanced}}" class="mini-choice">
        <button class="{{form.changedPlan === 'no' ? 'active' : ''}}" data-value="no" bindtap="selectChangedPlan">没有</button>
        <button class="{{form.changedPlan === 'yes' ? 'active' : ''}}" data-value="yes" bindtap="selectChangedPlan">有改动</button>
      </view>

      <view wx:if="{{showAdvanced}}" class="quick-label">有没有提前写边界条件？</view>
      <view wx:if="{{showAdvanced}}" class="mini-choice">
        <button class="{{form.exitPrepared === 'yes' ? 'active' : ''}}" data-value="yes" bindtap="selectExitPrepared">已写清</button>
        <button class="{{form.exitPrepared === 'no' ? 'active' : ''}}" data-value="no" bindtap="selectExitPrepared">未写清</button>
      </view>

      <input wx:if="{{showAdvanced}}" value="{{form.afterReaction}}" bindinput="inputAfterReaction" placeholder="行动后第一反应是什么？例：后悔 / 松一口气 / 想再来一次" />
    </view>

    <view wx:if="{{!report && !form.screenshotPath && !manualAnchorVisible && !form.symbol}}" class="report-gate-hint">
      先留住一条真实记录，再进入第一念；完成后生成你的第一面活镜。
    </view>
    <view wx:elif="{{!report && (form.screenshotPath || manualAnchorVisible || form.symbol) && !form.firstThought}}" class="report-gate-hint">
      记录已留住。下一步，选择当时最强的一念。
    </view>
    <view wx:elif="{{!report && (form.screenshotPath || manualAnchorVisible || form.symbol) && form.firstThought && !form.nextAction}}" class="report-gate-hint">
      第一念已确认。最后选择下一次执行动作。
    </view>

    <view wx:if="{{(form.screenshotPath || manualAnchorVisible || form.symbol) && form.firstThought && form.nextAction}}" class="primary-stack quick-actions">
      <button class="primary-btn" bindtap="generateReview">生成活镜复盘</button>
      <button class="ghost-btn" bindtap="toggleAdvanced">{{showAdvanced ? '收起细节' : '补充细节'}}</button>
    </view>

    <view wx:if="{{showAdvanced && !manualAnchorVisible && !form.screenshotPath && !form.symbol}}" class="form-card card">
      <text>历史数据锚点</text>
      <view class="field-grid">
        <view>
          <text>记录日期</text>
          <picker mode="date" value="{{form.tradeDate}}" bindchange="changeDate">
            <view>{{form.tradeDate}}</view>
          </picker>
        </view>
        <view>
          <text>股票代码</text>
          <input value="{{form.symbol}}" bindinput="inputSymbol" placeholder="例如：600123" />
        </view>
      </view>
    </view>

    <view wx:if="{{showAdvanced}}" class="form-card card">
      <text>当时反应</text>
      <view class="field-label">阶段位置</view>
      <view class="choice-grid">
        <button wx:for="{{stagePositions}}" wx:key="key" class="{{form.stagePositionKey === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="selectStage">
          <text>{{item.label}}</text>
          <view>{{item.gate}}</view>
        </button>
      </view>

      <view class="field-label">行为倾向</view>
      <view class="choice-grid">
        <button wx:for="{{actions}}" wx:key="key" class="{{form.actionKey === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="selectAction">
          <text>{{item.label}}</text>
          <view>{{item.type}}</view>
        </button>
      </view>

      <view class="field-label">情绪</view>
      <view class="emotion-grid">
        <button wx:for="{{emotions}}" wx:key="*this" class="{{form.emotion === item ? 'active' : ''}}" data-value="{{item}}" bindtap="selectEmotion">{{item}}</button>
      </view>

      <view class="field-label">守界状态</view>
      <view class="choice-grid boundary">
        <button wx:for="{{boundaryStates}}" wx:key="key" class="{{form.boundaryState === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="selectBoundaryState">
          <text>{{item.label}}</text>
          <view>{{item.score}}</view>
        </button>
      </view>

      <input value="{{form.planBoundary}}" bindinput="inputBoundary" placeholder="当时应守住哪条边界？" />
      <textarea value="{{form.reviewNote}}" bindinput="inputNote" placeholder="回看这条记录，你照见了什么？" />
    </view>

    <view wx:if="{{showAdvanced}}" class="split-actions">
      <button class="ghost-btn" bindtap="resetForm">重新填写</button>
      <button class="primary-btn" bindtap="generateReview">生成活镜复盘</button>
    </view>

    <view wx:if="{{report}}" class="report-card card">
      <view class="result-rite">
        <view class="result-seal">镜</view>
        <view>
          <text>已写入活镜</text>
          <view>这一次复盘，已进入你的行为印记。</view>
        </view>
      </view>
      <text>活镜回响</text>
      <view class="one-line">{{report.oneLine}}</view>
      <view class="verdict-card">
        <text>判词</text>
        <view>{{report.verdict}}</view>
      </view>
      <view wx:if="{{showResultDetail}}" class="match-card">
        <text>{{report.historicalMatch.marketLabel}} · {{report.historicalMatch.timeframeLabel}} · {{report.historicalMatch.tradeDate}}</text>
        <view>{{report.historicalMatch.symbol}} · {{report.historicalMatch.stagePosition}}</view>
        <view>{{report.historicalMatch.sourceStatus}}</view>
      </view>
      <view wx:if="{{showResultDetail}}" class="mirror-grid">
        <view>
          <text>本次行为镜</text>
          <view>{{report.relatedMirror}}</view>
        </view>
        <view>
          <text>对应六贼</text>
          <view>{{report.heartThievesText}}</view>
        </view>
        <view>
          <text>关口</text>
          <view>{{report.stageGate}}</view>
        </view>
        <view>
          <text>守界</text>
          <view>{{report.boundaryStateLabel}}</view>
        </view>
      </view>

      <view wx:if="{{showResultDetail}}" class="score-list">
        <view wx:for="{{report.scoreRows}}" wx:key="key">
          <text>{{item.label}}</text>
          <view><view style="width: {{item.value}}%;"></view></view>
          <text>{{item.value}}</text>
        </view>
      </view>

      <view wx:if="{{showResultDetail}}" class="evidence-list">
        <view wx:for="{{report.evidenceChain}}" wx:key="label">
          <text>{{item.label}}</text>
          <view>{{item.value}}</view>
          <view>{{item.detail}}</view>
        </view>
      </view>

      <view class="training-action">
        <text>针对训练</text>
        <view>{{report.trainingAction}}</view>
      </view>
      <view class="report-arrival-card card">
        <text>心镜报告</text>
        <view>复盘完成后，心镜报告会在这里出现。</view>
        <button class="ghost-btn" bindtap="goGeneratedDetail">查看心镜报告</button>
      </view>
      <view wx:if="{{showResultDetail && closure}}" class="closure-card">
        <text>{{closure.title}}</text>
        <view class="closure-proof">{{closure.proofLine}}</view>
        <view class="closure-mirror">{{closure.mirrorLine}}</view>
        <view class="closure-status">{{closure.statusText}}</view>
        <view class="closure-steps">
          <view wx:for="{{closure.steps}}" wx:key="key" class="{{item.done ? 'done' : item.current ? 'current' : ''}}">
            <text>{{item.label}}</text>
            <view>{{item.value}}</view>
          </view>
        </view>
        <view class="closure-next">
          <text>下一次只练</text>
          <view>{{closure.trainingAction}}</view>
        </view>
      </view>
      <view class="split-actions result-actions">
        <button class="ghost-btn" bindtap="goGeneratedDetail">{{closure.detailActionText || '查看复盘详情'}}</button>
        <button class="primary-btn" bindtap="goLivingMirror">{{closure.primaryActionText || '查看活镜成长'}}</button>
      </view>
      <view class="single-action">
        <button class="ghost-btn" bindtap="toggleResultDetail">{{showResultDetail ? '收起复盘细节' : '展开复盘细节'}}</button>
        <button class="ghost-btn" bindtap="goKlineTraining">{{closure.klineActionText || '进入 K 线观心'}}</button>
      </view>
    </view>

    <view wx:if="{{records.length}}" class="recent-card card">
      <view class="recent-head">
        <text>最近复盘</text>
        <button bindtap="goReviewArchive">进入档案</button>
      </view>
      <view wx:for="{{records}}" wx:key="id" class="recent-row" data-id="{{item.id}}" bindtap="goReviewDetail">
        <view>{{item.tradeDate}} · {{item.marketLabel}} · {{item.symbol}}</view>
        <text>{{item.relatedMirror}}</text>
      </view>
    </view>

    <compliance-notice variant="full" />
  </view>
</view>
