{
  "name": "trading-personality-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node src/index.js",
    "start": "node src/index.js",
    "generate:questions": "node scripts/generate-question-bank.mjs",
    "import:questions": "node scripts/import-question-bank.mjs",
    "seed:ymty": "node scripts/seed-ymty-defaults.mjs",
    "generate:kline": "node scripts/generate-kline-bank.mjs",
    "cache:ashare": "node scripts/cache-ashare-market-data.mjs",
    "cache:akshare": "python3 scripts/sync-akshare-offline.py",
    "download:kline": "node scripts/download-kline-history.mjs",
    "kline:update": "node scripts/update-kline-cache.js",
    "kline:verify": "node scripts/verify-kline-cache.js",
    "kline:benchmark": "node scripts/benchmark-kline-providers.js",
    "kline:backfill": "node scripts/backfill-kline-cache.js",
    "update:ashare": "node scripts/cache-ashare-market-data.mjs --limit all --timeframes 101 --delay 300 --incremental --summary-only",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:data-binding": "node --test scripts/data-binding-contract-test.mjs",
    "test:mirror-archive": "node --test scripts/mirror-archive-test.mjs",
    "test:training-bookmarks": "node --test scripts/training-bookmarks-test.mjs",
    "test:global-reflection": "node --test scripts/global-reflection-test.mjs",
    "test:i18n": "node --test scripts/i18n-contract-test.mjs",
    "test:training-packs": "node --test scripts/training-packs-test.mjs",
    "test:kline-segments": "node --test scripts/kline-segments-test.mjs",
    "test:sampling": "node --test scripts/kline-sampling-test.mjs",
    "test:kline-history": "node --test scripts/historical-kline-contract-test.mjs",
    "test:ymty": "SKIP_LOCAL_ENV=true node --test --test-concurrency=1 scripts/ymty-admin-auth-test.mjs && SKIP_LOCAL_ENV=true node --test --test-concurrency=1 scripts/ymty-payment-contract-test.mjs && SKIP_LOCAL_ENV=true node --test --test-concurrency=1 scripts/ymty-payment-precheck-test.mjs && SKIP_LOCAL_ENV=true node --test --test-concurrency=1 scripts/ymty-real-payment-create-test.mjs && SKIP_LOCAL_ENV=true node --test --test-concurrency=1 scripts/ymty-real-payment-notify-test.mjs && SKIP_LOCAL_ENV=true node --test --test-concurrency=1 scripts/ymty-mock-payment.test.mjs",
    "test:ymty-h5": "SKIP_LOCAL_ENV=true node --test scripts/ymty-h5-static-test.mjs",
    "test:ymty-upload": "SKIP_LOCAL_ENV=true node --test scripts/ymty-admin-upload-test.mjs",
    "test:ymty-livecode-pool": "SKIP_LOCAL_ENV=true node --test --test-concurrency=1 scripts/ymty-livecode-pool-test.mjs",
    "test:ymty-crm": "SKIP_LOCAL_ENV=true node --test --test-concurrency=1 scripts/ymty-crm-test.mjs",
    "test:ymty-refund": "SKIP_LOCAL_ENV=true node --test --test-concurrency=1 scripts/ymty-refund-test.mjs",
    "test:ymty-refund-controls": "SKIP_LOCAL_ENV=true node --test --test-concurrency=1 scripts/ymty-refund-controls-test.mjs",
    "test:ymty-wecom": "SKIP_LOCAL_ENV=true node --test --test-concurrency=1 scripts/ymty-wecom-integration-test.mjs",
    "test:ymty-analytics": "SKIP_LOCAL_ENV=true node --test --test-concurrency=1 scripts/ymty-analytics-test.mjs",
    "test:ymty-admin-auth": "SKIP_LOCAL_ENV=true node --test scripts/ymty-admin-auth-test.mjs",
    "test:ymty-mock": "node --test scripts/ymty-mock-payment.test.mjs",
    "check": "node --check src/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "alipay-sdk": "^4.14.0"
  }
}
